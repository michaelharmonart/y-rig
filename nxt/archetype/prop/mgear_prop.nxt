{
    "version": "1.17",
    "alias": "mgear_prop",
    "color": "#7741c9",
    "mute": false,
    "solo": false,
    "references": [
        "util/mgear.nxt",
        "archetype/anim_rig.nxt"
    ],
    "meta_data": {
        "positions": {
            "/shifter_build": [
                -840.0,
                -120.0
            ]
        },
        "collapse": {
            "/build/base_controls": true,
            "/tools_window/tools/mgear": false,
            "/tools_window/tools/mgear/shifter_guides_io": true
        }
    },
    "nodes": {
        "/": {
            "attrs": {
                "rig_path": {
                    "type": "raw",
                    "value": "prop/mgear_prop"
                }
            }
        },
        "/build/base_controls/local": {
            "enabled": true,
            "attrs": {
                "control_parent": {
                    "value": "${../global.control}"
                }
            }
        },
        "/build/base_controls/shot": {
            "enabled": false
        },
        "/setup": {
            "child_order": [
                "new_scene",
                "shifter_component_build",
                "root"
            ]
        },
        "/setup/shifter_component_build": {
            "instance": "/shifter_build",
            "child_order": [
                "world_control_color"
            ],
            "attrs": {
                "custom_steps": {
                    "value": "False"
                },
                "guide_filepath": {
                    "type": "raw",
                    "value": "${file::${rig_path}/data/guide.sgt}"
                }
            }
        },
        "/setup/shifter_component_build/world_control_color": {
            "attrs": {
                "color": {
                    "type": "raw",
                    "value": "${_nxtcolor}"
                },
                "world_control": {
                    "type": "raw",
                    "value": "world_ctl"
                }
            },
            "code": [
                "yrig.control.set_override_color(\"${world_control}\", color=\"${color}\", override_shapes=True)"
            ]
        }
    }
}