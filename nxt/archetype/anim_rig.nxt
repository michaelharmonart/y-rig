                    "type": "raw",
                    "value": "Skin Data"
                }
            }
        },
        "/tools_window/tools/skin/skin_data_io/export": {
            "attrs": {
                "text": {
                    "value": "Export Skin Data"
                }
            }
        },
        "/tools_window/tools/skin/skin_data_io/import": {
            "attrs": {
                "text": {
                    "value": "Import Skin Data"
                }
            }
        },
        "/tools_window/tools/visibility_sets_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "relative_filepath": {
                    "value": "data/visibility.ysets"
                },
                "text": {
                    "value": "Visibility Sets"
                },
                "visibility_set_name": {
                    "type": "raw",
                    "value": "rig_visibility_sets"
                }
            }
        },
        "/tools_window/tools/visibility_sets_io/export": {
            "attrs": {
                "text": {
                    "value": "Export Visibility Sets"
                }
            },
            "code": [
                "export_root_path = \"${export_root_path}\"",
                "if not export_root_path or not Path(export_root_path).is_dir():",
                "    raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "export_path = Path(\"${export_path}\")",
                "",
                "yrig.sets.export_sets(export_path, \"${visibility_set_name}\")"
            ]
        },
        "/tools_window/tools/visibility_sets_io/import": {
            "attrs": {
                "rig_set": {
                    "type": "raw",
                    "value": "rig_sets_grp"
                },
                "text": {
                    "value": "Import Visibility Sets"
                }
            },
            "code": [
                "import_path = Path(\"${import_filepath}\")",
