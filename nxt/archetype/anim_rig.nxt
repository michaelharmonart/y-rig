            "/shape_io": true,
            "/skin_data_io": true,
            "/tools_window/tools/control_shapes/control_shapes_io": true,
            "/tools_window/tools/control_shapes/control_shapes_io/export": true,
            "/tools_window/tools/control_shapes/control_shapes_io/import": true,
            "/tools_window/tools/geometry/geometry_io": true,
            "/tools_window/tools/skin/skin_data_io": true,
            "/tools_window/tools/visibility_sets_io": false
        },
        "locks": {
            "$YRIG_NXT_DIR/core.nxt": false,
            "/users/student/g/graphite/maya-python/y-rig/nxt/skin.nxt": false
        }
    },
    "nodes": {
        "/": {
            "attrs": {
                "build_scope": {
                    "comment": "The build scope for the rig. eg. \"full\" \"face\" \"body\"",
                    "type": "raw",
                    "value": "full"
                },
                "dev_build": {
                    "comment": "When False the rig should be built ready for publish",
                    "type": "bool",
                    "value": "False"
                },
                "rig_path": {
                    "comment": "The relative path to the main directory for this rig's build files"
                }
            }
        },
        "/apply": {
            "execute_in": "/build",
            "child_order": [
                "rest_pose",
                "control_shapes",
                "deformation",
                "visibility_sets"
            ]
        },
        "/apply/control_shapes": {
            "attrs": {
                "control_shapes_filepath": {
                    "type": "raw",
                    "value": "${file::${rig_path}/data/control_shapes.json}"
                }
            },
            "code": [
                "import_paths = [Path(filepath) for filepath in ${filelist::${control_shapes_filepath}}]",
                "yrig.control.serialize.apply_control_shapes_files(import_paths)",
                "cmds.refresh()"
            ]
        },
        "/apply/deformation": {
            "child_order": [
                "main"
            ]
        },
        "/apply/deformation/main": {
            "child_order": [
                "skin",
                "psd"
            ]
        },
        "/apply/deformation/main/psd": {
            "instance": "/psd_layer"
        },
        "/apply/deformation/main/skin": {
            "instance": "/skin_geometry",
            "child_order": [
                "split"
            ],
            "attrs": {
                "geo_set": {
                    "value": "${/setup/root/model.model_set}"
                },
                "skin_directory": {
                    "value": "${file::${rig_path}/data/skin}"
                }
            }
        },
        "/apply/deformation/main/skin/split": {
            "instance": "/split_skin_weights"
        },
        "/apply/rest_pose": {
            "attrs": {
                "control_set": {
                    "type": "raw",
                    "value": "${/setup/root/controls.control_set}"
                },
                "rest_pose": {
                    "type": "raw",
                    "value": "dagPose1"
                }
            },
            "code": [
                "controls = cmds.sets(\"${control_set}\", query=True) or []",
                "if controls:",
                "    pose = \"${rest_pose}\"",
                "    if cmds.ls(pose, type=\"dagPose\"):",
                "        cmds.dagPose(controls, name=\"${rest_pose}\", addToPose=True)",
                "    else:",
                "        pose = cmds.dagPose(controls, name=pose, save=True)",
                "    ",
                "    "
            ]
        },
        "/apply/visibility_sets": {
            "attrs": {
                "rig_set": {
                    "type": "raw",
                    "value": "${/setup/root.rig_set}"
                },
                "visibility_sets_filepath": {
                    "type": "raw",
                    "value": "${file::${rig_path}/data/visibility.ysets}"
                }
            },
            "code": [
                "if \"${visibility_sets_filepath}\":",
                "    filepath = Path(\"${visibility_sets_filepath}\")",
                "    yrig.sets.import_sets(filepath, parent=\"${rig_set}\")"
            ]
        },
        "/build": {
            "execute_in": "/setup",
            "child_order": [
                "middle",
                "left",
                "right"
            ]
        },
        "/build/left": {
            "instance": "/side",
            "execute_in": "/middle",
            "attrs": {
                "control_color": {
                    "value": "[0.105, 0.447, 0.911]"
                },
                "side": {
                    "value": "L"
                }
            }
        },
        "/build/middle": {
            "instance": "/side",
            "execute_in": "/setup",
            "attrs": {
                "control_color": {
                    "value": "[1.0, 0.8786, 0.0]"
                }
            }
        },
        "/build/right": {
            "instance": "../left",
            "execute_in": "/left",
            "attrs": {
                "control_color": {
                    "value": "[0.811, 0.080, 0.108]"
                },
                "side": {
                    "value": "R"
                },
                "side_mult": {
                    "value": "-1"
                }
            }
        },
        "/finalize": {
            "execute_in": "/apply",
            "child_order": [
                "delete_guides",
                "hide_joints",
                "model_override",
                "skin_tools_data",
                "metadata",
                "lock_attrs"
            ]
        },
        "/finalize/delete_guides": {
            "attrs": {
                "guides_group": {
                    "type": "raw",
                    "value": "${/setup/root/guides.guides_group}"
                }
            },
            "code": [
                "guides_group = \"${guides_group}\"",
                "if cmds.objExists(guides_group):",
                "    cmds.delete(guides_group)"
            ]
        },
        "/finalize/hide_joints": {
            "code": [
                "if not ${dev_build}:",
                "    # Hide Joints",
                "    cmds.setAttr(\"${/setup/root.rig_root}.jnt_vis\", False)  # type: ignore",
                ""
            ]
        },
        "/finalize/lock_attrs": {
            "attrs": {
                "ignored_attrs": {
                    "type": "list",
                    "value": "[\"visibility\"]"
                },
                "ignored_nodes": {
                    "type": "list",
                    "value": "[\"${/setup/root.rig_root}\"]"
                }
            },
            "code": [
                "DEFAULT_NODES = getattr(STAGE, \"default_nodes\", {})",
                "log = yrig.build.nxt_api.get_node_logger(\"${_nxtpath}\")",
                "",
                "def get_ik_joints() -> set[str]:",
                "    joints = set()",
                "    for handle in cmds.ls(type=\"ikHandle\") or []:",
                "        chain = cmds.ikHandle(handle, query=True, jointList=True) or []",
                "        joints.update(chain)",
                "    return set(joints)",
                "",
                "def is_connected(plug: str) -> bool:",
                "    try:",
                "        if cmds.listConnections(plug, source=True, destination=True):",
                "            return True",
                "        node, attr = plug.split(\".\", 1)",
                "        parent: list[float] = cmds.attributeQuery(attr.split(\".\")[-1], node=node, listParent=True)  # type: ignore",
                "        if parent:",
                "            return bool(cmds.listConnections(f\"{node}.{parent[0]}\", source=True, destination=True))",
                "    except (RuntimeError, ValueError):",
                "        # Can't be resolved, so treat it as \"don't touch\"",
                "        return True",
                "    return False",
                "",
                "",
                "def lock_non_control_attrs(ignored_nodes: set[str], ignored_attrs: set[str]) -> list[str] | None:",
                "    controls = yrig.control.get_tagged_controls()",
                "    if not controls:",
                "        log.warning(\"No controller tags found - aborting so nothing gets locked by mistake.\")",
                "        return",
                "",
                "    nodes = cmds.ls(type=\"transform\") or []",
                "    ik_joints = get_ik_joints()",
                "    locked = []",
                "    skipped = []",
                "",
                "    for node in nodes:",
                "        short = node.split(\"|\")[-1]",
                "        if short in DEFAULT_NODES or short in ignored_nodes:",
                "            continue",
                "",
                "        # Controls are left completely untouched",
                "        if node in controls:",
                "            continue",
                "            ",
                "        if node in ik_joints:",
                "            continue",
                "",
                "        keyable = set(cmds.listAttr(node, keyable=True) or [])",
                "        channel_box = set(cmds.listAttr(node, channelBox=True) or [])",
                "",
                "        for attr in sorted((keyable | channel_box) - ignored_attrs):",
                "            plug = f\"{node}.{attr}\"",
                "",
                "            # Unindexed multi/compound names (e.g. constraint \"target.xxx\") don't resolve",
                "            if not cmds.objExists(plug):",
                "                skipped.append(plug)",
                "                continue",
                "",
                "            try:",
                "                if cmds.getAttr(plug, lock=True):",
                "                    continue",
                "            except (RuntimeError, ValueError):",
                "                skipped.append(plug)",
                "                continue",
                "",
                "            if is_connected(plug):",
                "                continue",
                "",
                "            locked.append(plug)",
                "            try:",
                "                cmds.setAttr(plug, lock=True)",
                "            except RuntimeError as e:",
                "                log.warning(f\"Could not lock {plug}: {e}\")",
                "    return locked",
                "",
                "if not ${dev_build}:",
                "    locked = lock_non_control_attrs(ignored_nodes=set(${ignored_nodes}), ignored_attrs=set(${ignored_attrs}))",
                "    if locked:",
                "        log.info(f\"Locked {len(locked)} attributes.\")"
            ]
        },
        "/finalize/metadata": {
            "child_order": [
                "build_commit"
            ],
            "attrs": {
                "metadata_node": {
                    "type": "raw",
                    "value": "METADATA"
                },
                "rig_root": {
                    "type": "raw",
                    "value": "${/setup/root.rig_root}"
                }
            },
            "code": [
                "metadata_node = cmds.createNode(\"network\", name=\"${metadata_node}\")",
                "cmds.addAttr(",
                "    metadata_node,",
                "    longName=\"rig_root\",",
                "    attributeType=\"message\",",
                ")",
                "rig_root = \"${rig_root}\"",
                "cmds.connectAttr(",
                "    f\"{rig_root}.message\",",
                "    f\"{metadata_node}.rig_root\",",
                ")"
            ]
        },
        "/finalize/metadata/build_commit": {
            "attrs": {
                "build_path": {
                    "type": "raw",
                    "value": "${file::${rig_path}}"
                }
            },
            "code": [
                "build_path_str = \"${build_path}\"",
                "build_path = Path(build_path_str) if build_path_str else None",
                "yrig.build.metadata.write_rig_build_metadata(\"${metadata_node}\", build_path)"
            ]
        },
        "/finalize/model_override": {
            "code": [
                "if not ${dev_build}:",
                "    geo_group = \"${/setup/root/model.model_group}\"",
                "    cmds.setAttr(f\"{geo_group}.overrideEnabled\", True)  # type: ignore",
                "    cmds.setAttr(f\"{geo_group}.overrideDisplayType\", 2)  # type: ignore",
                ""
            ]
        },
        "/finalize/skin_tools_data": {
            "code": [
                "if not ${dev_build}:",
                "    yrig.skin.ng.cleanup_ng_data_nodes()"
            ]
        },
        "/psd_import": {
            "child_order": [
                "shapes",
                "pose_intepolators"
            ],
            "attrs": {
                "geometry": {
                    "type": "list",
                    "value": "[]"
                },
                "psd_layer": {
                    "type": "raw",
                    "value": "main_psd"
                },
                "psd_path": {
                    "type": "raw",
                    "value": "${rig_path}/data/psd"
                },
                "psd_system": {
                    "type": "raw",
                    "value": "main"
                },
                "psd_system_path": {
                    "type": "raw",
                    "value": "${psd_path}/${psd_system}"
                }
            }
        },
        "/psd_import/pose_intepolators": {
            "attrs": {
                "pose_filepath": {
                    "type": "raw",
                    "value": "${file::${psd_system_path}/${psd_system}.ypose}"
                },
                "rbf_group": {
                    "type": "raw",
                    "value": "${/setup/root/deformation/rbf.rbf_group}"
                }
            },
            "code": [
                "pose_filepath_str = \"${pose_filepath}\"",
                "if pose_filepath_str:",
                "    pose_filepath = Path(pose_filepath_str)",
                "    yrig.rbf.pose_interpolator.import_pose_file(",
                "        filepath = pose_filepath,",
                "        parent = \"${rbf_group}\",",
                "    )"
            ]
        },
        "/psd_import/shapes": {
            "attrs": {
                "psd_network": {
                    "type": "raw",
                    "value": "${psd_system}_psd"
                },
                "resolved_yshape_directories": {
                    "type": "raw",
                    "value": "${filelist::${yshape_directory}}"
                },
                "yshape_directory": {
                    "type": "raw",
                    "value": "${file::${psd_system_path}}"
                }
            },
            "code": [
                "from yrig.deformer.blendshape import import_blendshapes_from_directories",
                "",
                "shape_directories = [Path(dir) for dir in ${resolved_yshape_directories}]",
                "geometry = ${geometry}",
                "",
                "def _geo_to_blendshape(geo: str):",
                "    return f\"{geo}_${psd_layer}\"",
                "    ",
                "if shape_directories and geometry:",
                "    import_blendshapes_from_directories(",
                "        shape_directories,",
                "        geometry,",
                "        geo_to_blendshape=_geo_to_blendshape,",
                "        psd_network=\"${psd_network}\",",
                "    )"
            ]
        },
        "/psd_io": {
            "instance": "",
            "child_order": [
                "shape_io",
                "rbf_io"
            ],
            "attrs": {
                "psd_directory": {
                    "type": "raw",
                    "value": "${psd_system}"
                },
                "psd_network": {
                    "type": "raw",
                    "value": "${psd_system}_psd"
                },
                "psd_system": {
                    "type": "raw",
                    "value": "main"
                },
                "relative_path_stem": {
                    "type": "raw",
                    "value": "data/psd/name"
                },
                "system_name": {
                    "type": "raw",
                    "value": "Main"
                }
            }
        },
        "/psd_io/rbf_io": {
            "instance": "/rbf_io",
            "attrs": {
                "filetype": {
                    "type": "raw",
                    "value": ".ypose"
                },
                "pair_name": {
                    "value": "${system_name} RBF"
                },
                "pose_directory": {
                    "value": "${psd_directory}"
                },
                "relative_filepath": {
                    "type": "raw",
                    "value": "${relative_path_stem}/${psd_system}${filetype}"
                }
            }
        },
        "/psd_io/shape_io": {
            "instance": "/shape_io",
            "attrs": {
                "blendshape_directory": {
                    "type": "raw",
                    "value": "${psd_directory}"
                },
                "filetype": {
                    "type": "raw",
                    "value": ".yshape"
                },
                "pair_name": {
                    "value": "${system_name} Shapes"
                },
                "relative_filepath": {
                    "type": "raw",
                    "value": "${relative_path_stem}"
                }
            }
        },
        "/psd_layer": {
            "attrs": {
                "geometry": {
                    "type": "list",
                    "value": "[]"
                },
                "psd_layer": {
                    "type": "raw",
                    "value": "main_psd"
                },
                "psd_path": {
                    "type": "raw",
                    "value": "${rig_path}/data/psd"
                }
            },
            "code": [
                "psd_layer = \"${psd_layer}\"",
                "",
                "for geo in ${geometry}:",
                "    yrig.deformer.blendshape.create_blendshape(geometry=geo, name=f\"{geo}_{psd_layer}\")"
            ]
        },
        "/rbf_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "pair_name": {
                    "value": "RBF"
                },
                "pose_directory": {},
                "rbf_group": {
                    "type": "raw",
                    "value": "rbf"
                },
                "relative_filepath": {
                    "value": "data/psd/name.ypose"
                }
            }
        },
        "/rbf_io/export": {
            "code": [
                "export_root_path = \"${export_root_path}\"",
                "if not export_root_path or not Path(export_root_path).is_dir():",
                "    raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "export_path = Path(\"${export_path}\")",
                "",
                "yrig.rbf.pose_interpolator.export_pose_file(export_path, directories=[\"${pose_directory}\"])"
            ]
        },
        "/rbf_io/import": {
            "code": [
                "import_path = Path(\"${import_filepath}\")",
                "",
                "yrig.rbf.pose_interpolator.import_pose_file(",
                "    import_path, ",
                "    parent=\"${rbf_group}\",",
                ")"
            ]
        },
        "/setup": {
            "start_point": true,
            "child_order": [
                "new_scene",
                "root"
            ]
        },
        "/setup/new_scene": {
            "code": [
                "cmds.file(new=True, force=True)",
                "STAGE.default_nodes = set(cmds.ls())"
            ]
        },
        "/setup/root": {
            "start_point": false,
            "child_order": [
                "model",
                "guides",
                "controls",
                "deformation",
                "logic"
            ],
            "attrs": {
                "rig_root": {
                    "comment": "Name for the root node that houses the entire rig.",
                    "type": "raw",
                    "value": "rig"
                },
                "rig_set": {
                    "comment": "Name for the set that houses all the sets for this rig.",
                    "type": "raw",
                    "value": "${rig_root}_sets_grp"
                }
            },
            "code": [
                "rig_root = \"${rig_root}\"",
                "if not cmds.objExists(rig_root):",
                "    self.rig_root = yrig.transform.create_transform(rig_root)",
                "    ",
                "rig_set = \"${rig_set}\"",
                "if not cmds.objExists(rig_set):",
                "    cmds.sets(name=rig_set)"
            ]
        },
        "/setup/root/controls": {
            "attrs": {
                "control_set": {
                    "type": "raw",
                    "value": "${rig_root}_controllers_grp"
                }
            },
            "code": [
                "control_set_name = \"${control_set}\"",
                "if not cmds.objExists(control_set_name):",
                "   yrig.sets.add_set(control_set_name, parent=\"${rig_set}\")"
            ]
        },
        "/setup/root/deformation": {
            "child_order": [
                "static_joint",
                "main",
                "rbf"
            ],
            "attrs": {
                "joint_group": {
                    "type": "raw",
                    "value": "jnt_org"
                },
                "model_set": {
                    "type": "raw",
                    "value": "${/setup/root/model.model_set}"
                }
            },
            "code": [
                "joint_group = \"${joint_group}\"",
                "if not cmds.objExists(joint_group):",
                "    yrig.transform.create_transform(joint_group, parent=\"${rig_root}\")"
            ]
        },
        "/setup/root/deformation/main": {
            "attrs": {
                "deformers_set": {
                    "type": "raw",
                    "value": "${rig_root}_deformers_grp"
                },
                "joint_group": {
                    "type": "raw",
                    "value": "jnt_org"
                }
            },
            "code": [
                "rig_set = \"${deformers_set}\"",
                "if not cmds.objExists(rig_set):",
                "    yrig.sets.add_set(rig_set, parent=\"${rig_set}\")"
            ]
        },
        "/setup/root/deformation/rbf": {
            "attrs": {
                "rbf_group": {
                    "type": "raw",
                    "value": "rbf"
                }
            },
            "code": [
                "yrig.transform.create_transform(name=\"${rbf_group}\", parent=\"${rig_root}\")"
            ]
        },
        "/setup/root/deformation/static_joint": {
            "attrs": {
                "static_joint": {
                    "type": "raw",
                    "value": "static_jnt"
                }
            },
            "code": [
                "yrig.joint.create_joint(\"static\", parent=\"${joint_group}\", add_to_set=False)"
            ]
        },
        "/setup/root/guides": {
            "attrs": {
                "guides_filepath": {
                    "type": "raw",
                    "value": "${file::${rig_path}/data/guides.ma}"
                },
                "guides_group": {
                    "type": "raw",
                    "value": "guides"
                }
            },
            "code": [
                "guides_filepath_str = \"${guides_filepath}\"",
                "if guides_filepath_str:",
                "    guides_filepath = Path(guides_filepath_str)",
                "    yrig.io.import_maya_file(guides_filepath)"
            ]
        },
        "/setup/root/logic": {
            "attrs": {
                "logic_group": {
                    "type": "raw",
                    "value": "logic"
                }
            },
            "code": [
                "if not cmds.objExists(\"${logic_group}\"):",
                "    logic_group = yrig.transform.create_transform(\"${logic_group}\", parent=\"${rig_root}\")",
                "    cmds.hide(logic_group)"
            ]
        },
        "/setup/root/model": {
            "child_order": [
                "smooth_preview"
            ],
            "enabled": true,
            "attrs": {
                "model_filepath": {
                    "comment": "Filepath to the Model to be imported.",
                    "type": "raw",
                    "value": "${file::${rig_path}/assets/model.mb}"
                },
                "model_group": {
                    "comment": "The name of the group under which the model is parented.",
                    "type": "raw",
                    "value": "geo"
                },
                "model_set": {
                    "comment": "All imported model geometry is added to this set.",
                    "type": "raw",
                    "value": "${rig_root}_geo_grp"
                }
            },
            "code": [
                "from yrig.io import import_maya_file",
                "model_filepath = Path(\"${model_filepath}\")",
                "imported_nodes: list[str] = import_maya_file(model_filepath)",
                "",
                "top_level_nodes: list[str] = cmds.ls(imported_nodes, assemblies=True)",
                "",
                "# # Case 1: exactly one root transform",
                "if len(top_level_nodes) == 1:",
                "    top_level_node = top_level_nodes[0]",
                "    if cmds.nodeType(top_level_node) == \"transform\":",
                "        geo_grp = top_level_node",
                "    else:",
                "        geo_grp = cmds.group(top_level_node, name=\"${model_group}\", world=True)",
                "    if geo_grp != \"${model_group}\":",
                "        geo_grp = cmds.rename(geo_grp)",
                "else:",
                "    # Case 2: multiple top level transforms (we need to group them)",
                "    geo_grp = cmds.group(top_level_nodes, name=\"${model_group}\", world=True)  # type: ignore",
                "",
                "# Keep in mind the mgear rig object's \"model\" is actually the root rig transform.",
                "cmds.parent(geo_grp, \"${rig_root}\")",
                "cmds.reorder(geo_grp, front=True)",
                "cmds.reorder(geo_grp, relative=1)",
                "",
                "# Get the imported meshes",
                "meshes = cmds.listRelatives(geo_grp, allDescendents=True, type=\"mesh\")",
                "mesh_transforms = (",
                "    cmds.listRelatives(",
                "        meshes,  # type: ignore",
                "        parent=True,",
                "        fullPath=True,",
                "    )",
                "    or []",
                ")",
                "# remove duplicates",
                "mesh_transforms: list[str] = list(set(mesh_transforms))",
                "# Put the geo in the set.",
                "yrig.sets.add_to_set(mesh_transforms, \"${model_set}\", parent=\"${rig_set}\")",
                "cmds.viewFit()",
                ""
            ]
        },
        "/setup/root/model/smooth_preview": {
            "attrs": {
                "smooth_geo": {
                    "comment": "Geometry to set the smooth preview setting on. Like hitting 3 in the Maya viewport.",
                    "type": "list",
                    "value": "[]"
                }
            },
            "code": [
                "for geo in ${smooth_geo}:",
                "    yrig.shape.set_smooth_preview(geo)"
            ]
        },
        "/shape_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "blendshape": {
                    "type": "raw"
                },
                "blendshape_directory": {},
                "pair_name": {
                    "value": "Shapes"
                },
                "psd_layer": {
                    "type": "raw",
                    "value": "main_psd"
                },
                "psd_network": {
                    "type": "raw"
                },
                "relative_filepath": {
                    "type": "raw",
                    "value": "data/psd/name.yshape"
                }
            }
        },
        "/shape_io/export": {
            "code": [
                "export_root_path = \"${export_root_path}\"",
                "if not export_root_path or not Path(export_root_path).is_dir():",
                "    raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "export_path = Path(\"${export_path}\")",
                "",
                "def _map_geo_to_blendshape(geometry: str):",
                "    return f\"{geometry}_${psd_layer}\"",
                "",
                "selection = yrig.select.get_selection()",
                "yrig.deformer.blendshape.batch_export_blendshapes(",
                "    selection, ",
                "    directory=export_path, ",
                "    geo_to_blendshape=_map_geo_to_blendshape,",
                "    directories={\"${blendshape_directory}\"},",
                ")",
                "",
                ""
            ]
        },
        "/shape_io/import": {
            "attrs": {
                "shape_directories": {
                    "type": "raw",
                    "value": "${filelist::${import_filepath}}"
                }
            },
            "code": [
                "shape_directories = [Path(dir) for dir in ${shape_directories}]",
                "",
                "def _map_geo_to_blendshape(geometry: str):",
                "    return f\"{geometry}_${psd_layer}\"",
                "",
                "selection = yrig.select.get_selection()",
                "yrig.deformer.blendshape.import_blendshapes_from_directories(",
                "    shape_directories, ",
                "    geometry=selection,",
                "    geo_to_blendshape=_map_geo_to_blendshape,",
                "    psd_network=\"${psd_network}\"",
                ")"
            ]
        },
        "/skin_data_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "pair_name": {
                    "value": "Skin Data"
                },
                "relative_filepath": {
                    "value": "data/skin"
                },
                "strip_suffix": {}
            }
        },
        "/skin_data_io/export": {
            "code": [
                "export_root_path = \"${export_root_path}\"",
                "if not export_root_path or not Path(export_root_path).is_dir():",
                "    raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "export_path = Path(\"${export_path}\")",
                "",
                "",
                "",
                "strip_suffix = \"${strip_suffix}\"",
                "def _map_geo_to_file(geometry: str):",
                "    return geometry.removesuffix(strip_suffix)",
                "",
                "selection = yrig.select.get_selection()",
                "yrig.skin.export.batch_export_skin_data(",
                "    geometry=selection,",
                "    directory=export_path, ",
                "    map_geo_to_file=_map_geo_to_file",
                ")"
            ]
        },
        "/skin_data_io/import": {
            "attrs": {
                "skin_directories": {
                    "type": "raw",
                    "value": "${filelist::${import_filepath}}"
                }
            },
            "code": [
                "skin_directories = [Path(dir) for dir in ${skin_directories}]",
                "",
                "strip_suffix = \"${strip_suffix}\"",
                "def _map_geo_to_file(geometry: str):",
                "    return geometry.removesuffix(strip_suffix)",
                "",
                "selection = yrig.select.get_selection()",
                "yrig.skin.apply.apply_skin_data_from_directories(",
                "    skin_directories, ",
                "    geometry=selection,",
                "    map_geo_to_file=_map_geo_to_file,",
                ")"
            ]
        },
        "/skin_geometry": {
            "attrs": {
                "error_on_topology_change": {
                    "value": "not ${dev_build}"
                }
            }
        },
        "/tools_window/tools/control_shapes": {
            "instance": "/panel",
            "child_order": [
                "control_shapes_io"
            ],
            "attrs": {
                "text": {
                    "type": "raw",
                    "value": "Control Shapes"
                }
            }
        },
        "/tools_window/tools/control_shapes/control_shapes_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "relative_filepath": {
                    "value": "data/control_shapes.json"
                },
                "resolved_import_paths": {
                    "type": "raw",
                    "value": "${filelist::${import_filepath}}"
                }
            }
        },
        "/tools_window/tools/control_shapes/control_shapes_io/export": {
            "child_order": [
                "export_selected"
            ],
            "attrs": {
                "text": {
                    "value": "Export Control Shapes"
                }
            },
            "code": [
                "export_root_path = Path(\"${export_root_path}\")",
                "if not export_root_path.exists():",
                "    raise NotADirectoryError",
                "export_path = Path(\"${export_path}\")",
                "yrig.control.serialize.export_control_shapes_file(",
                "    filepath=export_path, ",
                "    force=${force}",
                ")"
            ]
        },
        "/tools_window/tools/control_shapes/control_shapes_io/export/export_selected": {
            "instance": "/menuItem",
            "attrs": {
                "text": {
                    "value": "Export Selected Control Shapes"
                }
            },
            "code": [
                "export_root_path = Path(\"${export_root_path}\")",
                "if not export_root_path.exists():",
                "    raise NotADirectoryError",
                "export_path = Path(\"${export_path}\")",
                "yrig.control.serialize.add_override_for_controls(",
                "    filepath=export_path, ",
                "    controls=yrig.select.get_selection(), ",
                "    force=${force}",
                ")"
            ]
        },
        "/tools_window/tools/control_shapes/control_shapes_io/import": {
            "child_order": [
                "import_selected"
            ],
            "attrs": {
                "text": {
                    "value": "Import Control Shapes"
                }
            },
            "code": [
                "import_paths = [Path(filepath) for filepath in ${resolved_import_paths}]",
                "yrig.control.serialize.apply_control_shapes_files(import_paths)"
            ]
        },
        "/tools_window/tools/control_shapes/control_shapes_io/import/import_selected": {
            "instance": "/menuItem",
            "attrs": {
                "text": {
                    "value": "Import Selected Control Shapes"
                }
            },
            "code": [
                "import_paths = [Path(filepath) for filepath in ${resolved_import_paths}]",
                "yrig.control.serialize.apply_control_shapes_files(",
                "    import_paths, ",
                "    yrig.select.get_selection(),",
                ")"
            ]
        },
        "/tools_window/tools/geometry/geometry_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "geo_group": {
                    "type": "raw",
                    "value": "geo"
                },
                "relative_filepath": {
                    "value": "assets/model.mb"
                }
            }
        },
        "/tools_window/tools/geometry/geometry_io/export": {
            "attrs": {
                "text": {
                    "value": "Export Geometry"
                }
            },
            "code": [
                "export_root_path = \"${export_root_path}\"",
                "if not export_root_path or not Path(export_root_path).is_dir():",
                "    raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "export_path = Path(\"${export_path}\")",
                "",
                "yrig.io.export_maya_file(export_path, binary=True, nodes=[\"${geo_group}\"])"
            ]
        },
        "/tools_window/tools/geometry/geometry_io/import": {
            "attrs": {
                "text": {
                    "value": "Import Geometry"
                }
            },
            "code": [
                "import_path = Path(\"${import_filepath}\")",
                "",
                "yrig.io.import_maya_file(import_path)"
            ]
        },
        "/tools_window/tools/skin": {
            "instance": "/panel",
            "child_order": [
