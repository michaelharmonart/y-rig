{
    "version": "1.17",
    "alias": "rig",
    "color": "#0e8b5d",
    "mute": false,
    "solo": false,
    "references": [
        "util/tools.nxt",
        "util/skin.nxt",
        "core.nxt"
    ],
    "meta_data": {
        "positions": {
            "/apply": [
                45.101567325149915,
                -14.162854949084434
            ],
            "/cleanup": [
                467.7309816100551,
                -15.474659993798152
            ],
            "/cleanup/control_shapes": [
                0.0,
                0.0
            ],
            "/control_shapes": [
                -2.4974733523247323,
                95.12116921241874
            ],
            "/main": [
                -679.5661157024792,
                324.3636363636364
            ],
            "/middle": [
                -396.0467648945946,
                -12.903779307342678
            ],
            "/rest_pose": [
                107.99415846869607,
                265.1998166510077
            ],
            "/root": [
                -834.0036602069565,
                -12.525269102154974
            ],
            "/setup": [
                -858.5661157024792,
                -11.63636363636364
            ],
            "/setup/rig_hierarchy": [
                0.0,
                0.0
            ],
            "/shifter_build": [
                -745.8425286930325,
                -513.4641872897497
            ],
            "/shifter_component_build": [
                -1385.6737855003867,
                -12.961234388183893
            ],
            "/skin": [
                280,
                20
            ],
            "/skin_geometry": [
                -795.4972743705686,
                -408.77017313211803
            ],
            "/split_skin_weights": [
                -799.7965374561375,
                -465.0107915925667
            ],
            "/static_joint": [
                280,
                20
            ]
        },
        "collapse": {
            "/apply/deformation": false,
            "/cleanup/hide_joints": true,
            "/root/rig_hierarchy": true,
            "/setup/root": false
        },
        "locks": {
            "$YRIG_NXT_DIR/core.nxt": false,
            "/users/student/g/graphite/maya-python/y-rig/nxt/skin.nxt": false
        }
    },
    "nodes": {
        "/": {
            "attrs": {
                "build_scope": {
                    "comment": "The build scope for the rig. eg. \"full\" \"face\" \"body\"",
                    "type": "raw",
                    "value": "full"
                },
                "dev_build": {
                    "comment": "When False the rig should be built ready for publish",
                    "type": "bool",
                    "value": "False"
                },
                "rig_path": {
                    "comment": "The relative path to the main directory for this rig's build files"
                }
            }
        },
        "/apply": {
            "execute_in": "/middle",
            "child_order": [
                "rest_pose",
                "control_shapes",
                "deformation"
            ]
        },
        "/apply/control_shapes": {
            "attrs": {
                "control_shapes_filepath": {
                    "type": "raw",
                    "value": "${file::${rig_path}/data/control_shapes.json}"
                }
            },
            "code": [
                "control_shapes_filepath_str = \"${control_shapes_filepath}\"",
                "if control_shapes_filepath_str:",
                "    control_shapes_filepath = Path(control_shapes_filepath_str)",
                "    yrig.control.serialize.apply_control_shapes_file(control_shapes_filepath)"
            ]
        },
        "/apply/deformation": {
            "child_order": [
                "main"
            ]
        },
        "/apply/deformation/main": {
            "child_order": [
                "skin",
                "psd"
            ]
        },
        "/apply/deformation/main/psd": {
            "attrs": {
                "psd_group": {
                    "type": "raw",
                    "value": "psd"
                },
                "psd_group_parent": {
                    "type": "raw",
                    "value": "${/setup/root.rig_root}"
                }
            },
            "code": [
                "yrig.transform.create_transform(name=\"${psd_group}\", parent=\"${psd_group_parent}\")"
            ]
        },
        "/apply/deformation/main/skin": {
            "instance": "/skin_geometry",
            "child_order": [
                "split"
            ],
            "attrs": {
                "geo_set": {
                    "value": "${/setup/root/model.model_set}"
                },
                "skin_directory": {
                    "value": "${file::${rig_path}/data/skin}"
                }
            }
        },
        "/apply/deformation/main/skin/split": {
            "instance": "/split_skin_weights"
        },
        "/apply/rest_pose": {
            "attrs": {
                "rest_pose": {
                    "type": "raw",
                    "value": "dagPose1"
                }
            },
            "code": [
                "if STAGE.control_list:",
                "    cmds.dagPose(STAGE.control_list, name=\"${rest_pose}\", addToPose=True)"
            ]
        },
        "/cleanup": {
            "execute_in": "/apply",
            "child_order": [
                "hide_joints",
                "model_override",
                "skin_tools_data"
            ]
        },
        "/cleanup/hide_joints": {
            "code": [
                "if not ${dev_build}:",
                "    # Hide Joints",
                "    cmds.setAttr(\"${/setup/root.rig_root}.jnt_vis\", False)  # type: ignore",
                ""
            ]
        },
        "/cleanup/model_override": {
            "code": [
                "if not ${dev_build}:",
                "    geo_group = \"${/setup/root/model.model_group}\"",
                "    cmds.setAttr(f\"{geo_group}.overrideEnabled\", True)  # type: ignore",
                "    cmds.setAttr(f\"{geo_group}.overrideDisplayType\", 2)  # type: ignore",
                ""
            ]
        },
        "/cleanup/skin_tools_data": {
            "code": [
                "if not ${dev_build}:",
                "    yrig.skin.ng.cleanup_ng_data_nodes()"
            ]
        },
        "/middle": {
            "instance": "/side",
            "execute_in": "/setup"
        },
        "/setup": {
            "start_point": true,
            "child_order": [
                "root"
            ]
        },
        "/setup/root": {
            "start_point": false,
            "child_order": [
                "model",
                "guides",
                "controls",
                "deformation"
            ],
            "attrs": {
                "rig_root": {
                    "comment": "Name for the root node that houses the entire rig.",
                    "type": "raw",
                    "value": "rig"
                },
                "rig_set": {
                    "comment": "Name for the set that houses all the sets for this rig.",
                    "type": "raw",
                    "value": "${rig_root}_sets_grp"
                }
            },
            "code": [
                "rig_root = \"${rig_root}\"",
                "if not cmds.objExists(rig_root):",
                "    self.rig_root = yrig.transform.create_transform(rig_root)",
                "    ",
                "rig_set = \"${rig_set}\"",
                "if not cmds.objExists(rig_set):",
                "    cmds.sets(name=rig_set)"
            ]
        },
        "/setup/root/controls": {
            "code": [
                "STAGE.control_list = []"
            ]
        },
        "/setup/root/deformation": {
            "child_order": [
                "static_joint",
                "main"
            ],
            "attrs": {
                "joint_group": {
                    "type": "raw",
                    "value": "jnt_org"
                },
                "model_set": {
                    "type": "raw",
                    "value": "${/setup/root/model.model_set}"
                }
            },
            "code": [
                "joint_group = \"${joint_group}\"",
                "if not cmds.objExists(joint_group):",
                "    yrig.transform.create_transform(joint_group, parent=\"${rig_root}\")"
            ]
        },
        "/setup/root/deformation/main": {
            "attrs": {
                "deformers_set": {
                    "type": "raw",
                    "value": "${rig_root}_deformers_grp"
                },
                "joint_group": {
                    "type": "raw",
                    "value": "jnt_org"
                }
            },
            "code": [
                "rig_set = \"${deformers_set}\"",
                "if not cmds.objExists(rig_set):",
                "    cmds.sets(name=rig_set)"
            ]
        },
        "/setup/root/deformation/static_joint": {
            "attrs": {
                "static_joint": {
                    "type": "raw",
                    "value": "static_jnt"
                }
            },
            "code": [
                "yrig.joint.create_joint(\"static\", parent=\"${joint_group}\", add_to_set=False)"
            ]
        },
        "/setup/root/guides": {
            "attrs": {
                "guides_filepath": {
                    "type": "raw",
                    "value": "${file::${rig_path}/data/guides.mb}"
                }
            }
        },
        "/setup/root/model": {
            "child_order": [
                "smooth_preview"
            ],
            "attrs": {
                "model_filepath": {
                    "comment": "Filepath to the Model to be imported.",
                    "type": "raw",
                    "value": "${file::${rig_path}/assets/model.mb}"
                },
                "model_group": {
                    "comment": "The name of the group under which the model is parented.",
                    "type": "raw",
                    "value": "geo"
                },
                "model_set": {
                    "comment": "All imported model geometry is added to this set.",
                    "type": "raw",
                    "value": "${rig_root}_geo_grp"
                }
            },
            "code": [
                "from yrig.io import import_maya_file",
                "model_filepath = Path(\"${model_filepath}\")",
                "imported_nodes: list[str] = import_maya_file(model_filepath)",
                "",
                "top_level_nodes: list[str] = cmds.ls(imported_nodes, assemblies=True)",
                "",
                "# # Case 1: exactly one root transform",
                "if len(top_level_nodes) == 1:",
                "    top_level_node = top_level_nodes[0]",
                "    if cmds.nodeType(top_level_node) == \"transform\":",
                "        geo_grp = top_level_node",
                "    else:",
                "        geo_grp = cmds.group(top_level_node, name=\"${model_group}\", world=True)",
                "    if geo_grp != \"${model_group}\":",
                "        geo_grp = cmds.rename(geo_grp)",
                "else:",
                "    # Case 2: multiple top level transforms (we need to group them)",
                "    geo_grp = cmds.group(top_level_nodes, name=\"${model_group}\", world=True)  # type: ignore",
                "",
                "# Keep in mind the mgear rig object's \"model\" is actually the root rig transform.",
                "cmds.parent(geo_grp, \"${rig_root}\")",
                "cmds.reorder(geo_grp, front=True)",
                "cmds.reorder(geo_grp, relative=1)",
                "",
                "# Get the imported meshes",
                "meshes = cmds.listRelatives(geo_grp, allDescendents=True, type=\"mesh\")",
                "mesh_transforms = (",
                "    cmds.listRelatives(",
                "        meshes,  # type: ignore",
                "        parent=True,",
                "        fullPath=True,",
                "    )",
                "    or []",
                ")",
                "# remove duplicates",
                "mesh_transforms: list[str] = list(set(mesh_transforms))",
                "# Put the geo in the set.",
                "yrig.sets.add_to_set(mesh_transforms, \"${model_set}\", parent=\"${rig_set}\")",
                "cmds.viewFit()",
                ""
            ]
        },
        "/setup/root/model/smooth_preview": {
            "attrs": {
                "smooth_geo": {
                    "comment": "Geometry to set the smooth preview setting on. Like hitting 3 in the Maya viewport.",
                    "type": "list",
                    "value": "[]"
                }
            },
            "code": [
                "for geo in ${smooth_geo}:",
                "    yrig.shape.set_smooth_preview(geo)"
            ]
        },
        "/tools_window/tools/control_shapes": {
            "instance": "/panel",
            "child_order": [
                "control_shapes_io"
            ],
            "attrs": {
                "text": {
                    "type": "raw",
                    "value": "Control Shapes"
                }
            }
        },
        "/tools_window/tools/control_shapes/control_shapes_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "relative_filepath": {
                    "value": "data/control_shapes.json"
                }
            }
        },
        "/tools_window/tools/control_shapes/control_shapes_io/export": {
            "attrs": {
                "text": {
                    "value": "Export Control Shapes"
                }
            },
            "code": [
                "export_root_path = Path(\"${export_root_path}\")",
                "if not export_root_path.exists():",
                "    raise NotADirectoryError",
                "export_path = Path(\"${export_path}\")",
                "yrig.control.serialize.export_control_shapes_file(filepath=export_path, force=${force})"
            ]
        },
        "/tools_window/tools/control_shapes/control_shapes_io/import": {
            "attrs": {
                "text": {
                    "value": "Import Control Shapes"
                }
            },
            "code": [
                "import_path = Path(\"${import_filepath}\")",
                "yrig.control.serialize.apply_control_shapes_file(import_path)"
            ]
        },
        "/tools_window/tools/skin": {
            "instance": "/panel",
            "child_order": [
                "skin_data_io"
            ],
            "attrs": {
                "text": {
                    "value": "Skin"
                }
            }
        },
        "/tools_window/tools/skin/skin_data_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "relative_filepath": {
                    "value": "data/skin"
                },
                "text": {
                    "type": "raw",
                    "value": "Skin Data"
                }
            }
        },
        "/tools_window/tools/skin/skin_data_io/export": {
            "attrs": {
                "text": {
                    "type": "raw",
                    "value": "Export Skin Data"
                }
            },
            "code": [
                "export_root_path = \"${export_root_path}\"",
                "if not export_root_path or not Path(export_root_path).is_dir():",
                "    raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "export_path = Path(\"${export_path}\")",
                "",
                "selection = yrig.select.get_selection()",
                "yrig.skin.export.batch_export_skin_data(export_path, selected_only=True)"
            ]
        },
        "/tools_window/tools/skin/skin_data_io/import": {
            "attrs": {
                "resolved_skin_directories": {
                    "type": "raw",
                    "value": "${filelist::${import_filepath}}"
                },
                "text": {
                    "type": "raw",
                    "value": "Import Skin Data"
                }
            },
            "code": [
                "skin_directories = [Path(dir) for dir in ${resolved_skin_directories}]",
                "",
                "selection = yrig.select.get_selection()",
                "yrig.skin.apply.apply_skin_data_from_directories(",
                "    skin_directories, ",
                "    geometry=selection,",
                ")"
            ]
        }
    }
}