            ]
        },
        "/wrap": {
            "attrs": {
                "wrap_mapping": {
                    "type": "dict",
                    "value": "{}"
                }
            },
            "code": [
                "wrap_mapping = ${wrap_mapping}",
                "for source, target in wrap_mapping.items():",
                "    yrig.deformer.proximity_wrap.create_proximity_wrap(source, target)"
            ]
        }
    }
}