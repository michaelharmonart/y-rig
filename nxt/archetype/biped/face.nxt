{
    "version": "1.17",
    "alias": "face",
    "color": "#b28f11",
    "mute": false,
    "solo": false,
    "references": [
        "component/face/face_base.nxt",
        "component/face/eye.nxt",
        "component/face/eyebrow.nxt",
        "component/face/mouth.nxt",
        "component/face/tongue.nxt",
        "component/face/teeth.nxt",
        "component/face/nose.nxt",
        "component/face/ear.nxt"
    ],
    "nodes": {
        "/apply/deformation": {
            "child_order": [
                "face",
                "main"
            ]
        },
        "/apply/deformation/face": {
            "child_order": [
                "skin"
            ],
            "attrs": {
                "def_layer_group": {
                    "type": "raw",
                    "value": "${/setup/root/deformation/face.def_layer_group}"
                },
                "def_layer_name": {
                    "type": "raw",
                    "value": "face"
                }
            }
        },
        "/apply/deformation/face/skin": {
            "instance": "/skin_geometry",
            "child_order": [
                "split"
            ],
            "attrs": {
                "geo_list": {
                    "value": "${/setup/root/deformation/face/duplicate_geo.duplicated_geo}"
                },
                "skin_directory": {
                    "type": "raw",
                    "value": "${file::${rig_path}/data/face/skin}"
                },
                "strip_suffix": {
                    "type": "raw",
                    "value": "_${def_layer_group}"
                }
            }
        },
        "/apply/deformation/face/skin/split": {
            "instance": "/split_skin_weights"
        },
        "/cleanup": {
            "child_order": [
                "delete_face_guides",
                "hide_joints",
                "model_override",
                "skin_tools_data"
            ]
        },
        "/cleanup/delete_face_guides": {
            "attrs": {
                "face_guides_group": {
                    "type": "raw",
                    "value": "${/setup/root/guides/face.face_guides_group}"
                }
            },
            "code": [
                "cmds.delete(\"${face_guides_group}\")"
            ]
        },
        "/build/left": {
            "child_order": [
                "eye",
                "eyebrow",
                "ear"
            ]
        },
        "/build/left/ear": {
            "instance": "/ear_component",
            "attrs": {
                "control_parent": {
                    "value": "face_muppet_M_ctl"
                },
                "joint_parent": {
                    "value": "face_muppet_M_jnt"
                }
            }
        },
        "/build/left/eye": {
            "instance": "/eye_component",
            "attrs": {
                "control_parent": {
                    "value": "face_upper_M_ctl"
                },
                "joint_parent": {
                    "value": "face_upper_M_jnt"
                }
            }
        },
        "/build/left/eyebrow": {
            "instance": "/simple_eyebrow",
            "attrs": {
                "control_parent": {
                    "value": "face_top_M_ctl"
                },
                "joint_parent": {
                    "type": "raw",
                    "value": "face_top_M_jnt"
                }
            }
        },
        "/build/middle/face": {
            "child_order": [
                "base",
                "nose",
                "mouth",
                "tongue",
                "teeth",
                "look"
            ],
            "attrs": {
                "face_joint_parent": {
                    "type": "raw",
                    "value": "neck_M0_head_jnt"
                },
                "face_parent": {
                    "type": "raw",
                    "value": "neck_M0_head_ctl"
                }
            },
            "code": [
                "parent=\"${face_parent}\"",
                "joint_parent=\"${face_joint_parent}\"",
                "transform = \"face_M\" if cmds.objExists(\"face_M\") else None",
                "",
                "face_group = yrig.transform.create_transform(",
                "    name=\"face_grp\", ",
                "    parent=parent if cmds.objExists(parent) else None, ",
                "    transform=transform",
                ")",
                "face_joint = yrig.joint.create_joint(",
                "    \"face\", ",
                "    parent=joint_parent if cmds.objExists(joint_parent) else None, ",
                "    transform=transform, ",
                "    connect=False)"
            ]
        },
        "/build/middle/face/base": {
            "instance": "/face_base_component",
            "attrs": {
                "joint_parent": {
                    "value": "face_jnt"
                },
                "parent": {
                    "type": "raw",
                    "value": "${face_parent}"
                }
            }
        },
        "/build/middle/face/look": {
            "instance": "/look_component"
        },
        "/build/middle/face/mouth": {
            "instance": "/mouth_component",
            "child_order": [
                "skin_surface"
            ],
            "attrs": {
                "control_size": {
                    "value": "1"
                },
                "joint_parent": {
                    "value": "${/setup/root/deformation/face.def_layer_group}"
                },
                "parent": {
                    "value": "${/setup/root/deformation/face.def_layer_group}"
                }
            }
        },
        "/build/middle/face/mouth/skin_surface": {
            "attrs": {
                "mouth_surface_skin_filepath": {
                    "type": "raw",
                    "value": "${file::${rig_path}/data/face/mouth_surface.yskin}"
                }
            }
        },
        "/build/middle/face/nose": {
            "instance": "/nose_component"
        },
        "/build/middle/face/teeth": {
            "instance": "/teeth_component"
        },
        "/build/middle/face/tongue": {
            "instance": "/tongue_component"
        },
        "/setup/root/deformation/face": {
            "child_order": [
                "duplicate_geo"
            ],
            "attrs": {
                "def_layer_group": {
                    "type": "raw",
                    "value": "${def_layer_name}_setup"
                },
                "def_layer_name": {
                    "type": "raw",
                    "value": "face"
                },
                "parent": {
                    "type": "raw",
                    "value": "setup"
                }
            },
            "code": [
                "def_layer_group = yrig.transform.create_transform(\"${def_layer_group}\", parent=\"${parent}\")",
                "cmds.hide(def_layer_group)"
            ]
        },
        "/setup/root/deformation/face/duplicate_geo": {
            "attrs": {
                "duplicated_geo": {
                    "type": "list",
                    "value": "[]"
                },
                "geo_to_duplicate": {
                    "type": "list",
                    "value": "[\"body_geo\"]"
                }
            },
            "code": [
                "from yrig.shape import get_shape",
                "",
                "geo_to_duplicate = ${geo_to_duplicate}",
                "for geo in geo_to_duplicate:",
                "    duplicated = cmds.duplicate(geo, name=f\"{geo}_${def_layer_group}\")[0]",
                "    cmds.parent(duplicated, \"${def_layer_group}\")",
                "    geo_shape = get_shape(geo)",
                "    geo_input = cmds.deformableShape(geo_shape, frontOfChain=True)[0] or f\"{geo_shape}.{cmds.deformableShape(geo_shape, localShapeInAttr=True)[0]}\"",
                "    print(geo_input)",
                "    duplicated_shape = get_shape(duplicated)",
                "    duplicated_output = cmds.deformableShape(duplicated_shape, localShapeOutAttr=True)[0]",
                "    cmds.connectAttr(f\"{duplicated_shape}.{duplicated_output}\", geo_input)",
                "    cmds.sets(duplicated, remove=\"${model_set}\")",
                "    self.duplicated_geo.append(duplicated)"
            ]
        },
        "/setup/root/guides/face": {
            "attrs": {
                "face_guides_filepath": {
                    "type": "raw",
                    "value": "${file::${rig_path}/data/face/guides.ma}"
                },
                "face_guides_group": {
                    "type": "raw",
                    "value": "face_guide"
                }
            },
            "code": [
                "from yrig.io.maya import import_split_scene_files",
                "",
                "",
                "import_path = Path(\"${face_guides_filepath}\")",
                "folder = import_path.parent",
                "imported = import_split_scene_files(",
                "    directory=folder,",
                "    objects=[\"face_surface\"],",
                "    remainder_name=\"guides\",",
                ")"
            ]
        },
        "/tools_window/biped/face": {
            "instance": "/panel",
            "child_order": [
                "face_guides_io",
                "mouth_surface_io",
                "mouth_surf_skin_io",
                "solo_face_guides_io"
            ],
            "attrs": {
                "text": {
                    "value": "Face"
                }
            }
        },
        "/tools_window/biped/face/face_guides_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "relative_filepath": {
                    "type": "raw",
                    "value": "data/face"
                }
            }
        },
        "/tools_window/biped/face/face_guides_io/export": {
            "attrs": {
                "face_guides_group": {
                    "type": "raw",
                    "value": "face_guide"
                },
                "text": {
                    "value": "Export Face Guides"
                }
            },
            "code": [
                "from pathlib import Path",
                "",
                "from yrig.io.maya import split_scene_to_files",
                "",
                "export_root_path = (",
                "    Path(\"${export_root_path}\")",
                ")",
                "",
                "if not export_root_path.is_dir():",
                "    raise NotADirectoryError(",
                "        f\"Export root does not exist: {export_root_path}\"",
                "    )",
                "export_path = Path(\"${export_path}\")",
                "split_scene_to_files(",
                "    directory=export_path,",
                "    objects=[\"face_surface\"],",
                "    remainder_name=\"guides\",",
                ")"
            ]
        },
        "/tools_window/biped/face/face_guides_io/import": {
            "attrs": {
                "text": {
                    "value": "Import Face Guides"
                }
            },
            "code": [
                "from yrig.io.maya import import_split_scene_files",
                "",
                "import_path = Path(\"${import_filepath}\")",
                "imported = import_split_scene_files(",
                "    directory=import_path,",
                "    objects=[\"face_surface\"],",
                "    remainder_name=\"guides\",",
                ")"
            ]
        },
        "/tools_window/biped/face/mouth_surf_skin_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "mouth_surface": {
                    "type": "raw",
                    "value": "mouth_surface"
                },
                "relative_filepath": {
                    "value": "data/face/mouth_surface.yskin"
                },
                "text": {
                    "type": "raw",
                    "value": "Mouth Surf Skin"
                }
            }
        },
        "/tools_window/biped/face/mouth_surf_skin_io/export": {
            "attrs": {
                "text": {
                    "value": "Export Mouth Surf Skin"
                }
            },
            "code": [
                "export_root_path = \"${export_root_path}\"",
                "if not export_root_path or not Path(export_root_path).is_dir():",
                "    raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "export_path = Path(\"${export_path}\")",
                "yrig.skin.export_skin_weights(export_path, \"${mouth_surface}\")"
            ]
        },
        "/tools_window/biped/face/mouth_surf_skin_io/import": {
            "attrs": {
                "text": {
                    "value": "Import Mouth Surf Skin"
                }
            },
            "code": [
                "import_path = Path(\"${import_filepath}\")",
                "yrig.skin.apply_weights(import_path, \"${mouth_surface}\")"
            ]
        },
        "/tools_window/biped/face/mouth_surface_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "relative_filepath": {
                    "type": "raw",
                    "value": "data/face"
                },
                "text": {
                    "type": "raw",
                    "value": "Mouth Surface"
                }
            }
        },
        "/tools_window/biped/face/mouth_surface_io/export": {
            "attrs": {
                "text": {
                    "value": "Export Mouth Surface"
                }
            },
            "code": [
                "from pathlib import Path",
                "",
                "from yrig.io.maya import split_scene_to_files",
                "",
                "export_root_path = (",
                "    Path(\"${export_root_path}\")",
                ")",
                "",
                "if not export_root_path.is_dir():",
                "    raise NotADirectoryError(",
                "        f\"Export root does not exist: {export_root_path}\"",
                "    )",
                "    ",
                "export_path = Path(\"${export_path}\")",
                "split_scene_to_files(",
                "    directory=export_path,",
                "    objects=[\"face_surface\"],",
                "    remainder_name=None,",
                ")"
            ]
        },
        "/tools_window/biped/face/mouth_surface_io/import": {
            "attrs": {
                "text": {
                    "value": "Import Mouth Surface"
                }
            },
            "code": [
                "from yrig.io.maya import import_split_scene_files",
                "",
                "import_path = Path(\"${import_filepath}\")",
                "folder = import_path.parent",
                "imported = import_split_scene_files(",
                "    directory=folder,",
                "    objects=[\"face_surface\"],",
                "    remainder_name=\"guides\",",
                ")"
            ]
        },
        "/tools_window/biped/face/solo_face_guides_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "enabled": true,
            "attrs": {
                "relative_filepath": {
                    "value": "data/face"
                },
                "text": {
                    "value": "Solo Face Guides"
                }
            }
        },
        "/tools_window/biped/face/solo_face_guides_io/export": {
            "attrs": {
                "text": {
                    "value": "Export Solo Face Guides"
                }
            },
            "code": [
                "from pathlib import Path",
                "",
                "from yrig.io.maya import split_scene_to_files",
                "",
                "export_root_path = (",
                "    Path(\"${export_root_path}\")",
                ")",
                "",
                "if not export_root_path.is_dir():",
                "    raise NotADirectoryError(",
                "        f\"Export root does not exist: {export_root_path}\"",
                "    )",
                "    ",
                "export_path = Path(\"${export_path}\")",
                "split_scene_to_files(",
                "    directory=export_path,",
                "    objects=[\"face_surface\"],",
                "    remainder_name=\"guides\",",
                "    solo=True",
                ")"
            ]
        },
        "/tools_window/biped/face/solo_face_guides_io/import": {
            "attrs": {
                "text": {
                    "value": "Import Solo Face Guides"
                }
            },
            "code": [
                "from yrig.io.maya import import_split_scene_files",
                "",
                "import_path = Path(\"${import_filepath}\")",
                "folder = import_path.parent",
                "imported = import_split_scene_files(",
                "    directory=folder,",
                "    objects=[\"face_surface\"],",
                "    remainder_name=\"guides\",",
                "    solo=True",
                ")"
            ]
        }
    }
}
