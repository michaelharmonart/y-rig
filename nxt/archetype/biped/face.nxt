    "nodes": {
        "/cleanup": {
            "child_order": [
                "delete_face_guides",
                "hide_joints",
                "model_override",
                "skin_tools_data"
            ]
        },
        "/cleanup/delete_face_guides": {
            "attrs": {
                "face_guides_group": {
                    "type": "raw",
                    "value": "${/root/guides/face.face_guides_group}"
                }
            },
            "code": [
                "cmds.delete(\"${face_guides_group}\")"
            ]
        },
        "/left": {
            "child_order": [
                "eye",
                "eyebrow",
                "ear"
            ]
        },
        "/left/ear": {
            "instance": "/ear_component"
        },
        "/left/eye": {
            "instance": "/eye_component"
        },
        "/left/eyebrow": {
            "instance": "/simple_eyebrow",
            "attrs": {
                "joint_parent": {
                    "value": "face_jnt"
                }
            }
        },
        "/middle/face": {
            "child_order": [
                "nose",
                "mouth",
                "tongue",
                "teeth",
                "look"
            ],
            "attrs": {
                "joint_parent": {
                    "type": "raw",
                    "value": "neck_M0_head_jnt"
                },
                "parent": {
                    "type": "raw",
                    "value": "neck_M0_head_ctl"
                }
            },
            "code": [
                "parent=\"${parent}\"",
                "joint_parent=\"${joint_parent}\"",
                "transform = \"face_M\" if cmds.objExists(\"face_M\") else None",
                "",
                "face_group = yrig.transform.create_transform(",
                "    name=\"face_grp\", ",
                "    parent=parent if cmds.objExists(parent) else None, ",
                "    transform=transform",
                ")",
                "face_joint = yrig.joint.create_joint(",
                "    \"face\", ",
                "    parent=joint_parent if cmds.objExists(joint_parent) else None, ",
                "    transform=transform, ",
                "    connect=False)"
            ]
        },
        "/middle/face/look": {
            "instance": "/look_component"
        },
        "/middle/face/mouth": {
            "instance": "/mouth_component",
            "child_order": [
                "skin_surface"
            ],
            "attrs": {
                "control_size": {
                    "value": "1"
                },
                "joint_parent": {
                    "value": "face_jnt"
                }
            }
        },
        "/middle/face/mouth/skin_surface": {
            "attrs": {
                "mouth_surface_skin_filepath": {
                    "value": "${file::${rig_path}/data/face/mouth_surface.yskin}"
                }
            }
        },
        "/middle/face/nose": {
            "instance": "/nose_component",
            "code": [
                "group = yrig.transform.create_transform(name=\"${component_group}\", parent=\"${parent}\")",
                "cmds.setAttr(f\"{group}.overrideEnabled\", True)",
                "cmds.setAttr(f\"{group}.drawOverride.overrideRGBColors\", True)",
                "cmds.connectAttr(\"${control_layer}.controlColor\", f\"{group}.drawOverride.overrideColorRGB\")"
            ]
        },
        "/middle/face/teeth": {
            "instance": "/teeth_component"
        },
        "/middle/face/tongue": {
            "instance": "/tongue_component"
        },
        "/root/guides/face": {
            "attrs": {
                "face_guides_filepath": {
                    "type": "raw",
                    "value": "${file::${rig_path}/data/face/guides.mb}"
                },
                "face_guides_group": {
                    "type": "raw",
                    "value": "face_guide"
                }
            },
            "code": [
                "imported_nodes = cmds.file(\"${face_guides_filepath}\", i=True, defaultNamespace=True, returnNewNodes=True)"
            ]
        }
    }
}
