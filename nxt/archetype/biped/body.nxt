{
    "version": "1.17",
    "alias": "body",
    "color": "#662d82",
    "mute": false,
    "solo": false,
    "references": [
        "util/mgear.nxt"
    ],
    "meta_data": {
        "positions": {
            "/arms": [
                400,
                20
            ],
            "/hands": [
                400,
                20
            ],
            "/legs": [
                400,
                20
            ]
        }
    },
    "nodes": {
        "/apply/deformation/main/psd": {
            "child_order": [
                "body"
            ],
            "attrs": {
                "geometry": {
                    "value": "[\"body_geo\"]"
                }
            }
        },
        "/apply/deformation/main/psd/body": {
            "child_order": [
                "arms",
                "hands",
                "legs"
            ],
            "attrs": {
                "psd_path": {
                    "value": "${rig_path}/data/body/psd"
                }
            }
        },
        "/apply/deformation/main/psd/body/arms": {
            "instance": "/psd_import",
            "attrs": {
                "psd_system": {
                    "value": "arms"
                }
            }
        },
        "/apply/deformation/main/psd/body/hands": {
            "instance": "/psd_import",
            "attrs": {
                "psd_system": {
                    "value": "hands"
                }
            }
        },
        "/apply/deformation/main/psd/body/legs": {
            "instance": "/psd_import",
            "attrs": {
                "psd_system": {
                    "type": "raw",
                    "value": "legs"
                }
            }
        },
        "/apply/deformation/main/skin/transfer_sim_weights": {
            "instance": "/transfer_skin_weights",
            "attrs": {
                "transfer_mapping": {
                    "type": "dict",
                    "value": "{}"
                }
            }
        },
        "/apply/deformation/main/wrap_from_sim": {
            "instance": "/wrap",
            "attrs": {
                "wrap_mapping": {
                    "type": "dict",
                    "value": "{}"
                }
            }
        },
        "/setup": {
            "child_order": [
                "new_scene",
                "shifter_component_build",
                "root"
            ]
        },
        "/setup/shifter_component_build": {
            "start_point": false,
            "instance": "/shifter_build",
            "child_order": [
                "attribute_defaults",
                "finger_meta_fix"
            ],
            "attrs": {
                "body_rig_temp_filepath": {
                    "type": "raw",
                    "value": "${export_root_path}/${body_rig_temp_relative_filepath}"
                },
                "body_rig_temp_relative_filepath": {
                    "type": "raw",
                    "value": "assets/.temp/body.mb"
                },
                "build_caching": {
                    "type": "bool",
                    "value": "True"
                },
                "custom_steps": {
                    "value": "False"
                },
                "export_root_path": {
                    "type": "raw",
                    "value": "${file::${rig_path}}"
                },
                "guide_filepath": {
                    "value": "${file::${rig_path}/data/guide.sgt}"
                }
            },
            "code": [
                "log = yrig.build.nxt_api.get_node_logger(\"${_nxtpath}\")",
                "",
                "guide_path = Path(\"${guide_filepath}\")",
                "",
                "run_shifter_build = True",
                "body_rig_temp_filepath = Path(\"${body_rig_temp_filepath}\")",
                "if ${build_caching} and \"${build_scope}\" == \"face\":",
                "    if yrig.cache.is_cache_valid(body_rig_temp_filepath, guide_path):",
                "        yrig.io.import_maya_file(body_rig_temp_filepath)",
                "        run_shifter_build = False",
                "",
                "if run_shifter_build:",
                "    result = yrig.build.mgear_api.build_from_shifter_file(",
                "        guide_path, ",
                "        dev_build=${dev_build}, ",
                "        custom_steps=${custom_steps},",
                "    )",
                "    if result and ${build_caching}:",
                "        export_root_path = \"${export_root_path}\"",
                "        if not export_root_path or not Path(export_root_path).is_dir():",
                "            raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "        try:",
                "            yrig.io.export_maya_file(",
                "                body_rig_temp_filepath, ",
                "                binary=True, ",
                "                force=True,",
                "            )",
                "            yrig.cache.write_cache_metadata(",
                "                body_rig_temp_filepath,",
                "                guide_path,",
                "            )",
                "        except Exception as e:",
                "            log.warning(\"Couldn't export body build cache: {e}\")"
            ]
        },
        "/setup/shifter_component_build/attribute_defaults": {
            "code": [
                "for control in [\"armUI_L0_ctl\", \"armUI_R0_ctl\"]:",
                "    cmds.setAttr(f\"{control}.arm_ikref\", 5)",
                "",
                "for control in [\"legUI_L0_ctl\", \"legUI_R0_ctl\"]:",
                "    cmds.setAttr(f\"{control}.foot_angle_1\", -40)"
            ]
        },
        "/setup/shifter_component_build/finger_meta_fix": {
            "code": [
                "for side in [\"L\", \"R\"]:",
                "    for num in range(4):",
                "        control_name = f\"meta_{side}0_meta{num}_ctl\"",
                "        group_name = f\"finger_{side}{num}_root\"",
                "        cmds.parent(group_name, control_name)"
            ]
        },
        "/tools_window/biped/body": {
            "instance": "/panel",
            "child_order": [
                "psd"
            ],
            "attrs": {
                "text": {
                    "value": "Body"
                }
            }
        },
        "/tools_window/biped/body/psd": {
            "instance": "/panel",
            "child_order": [
                "arm_psd_io",
                "hand_psd_io",
                "leg_psd_io"
            ],
            "attrs": {
                "text": {
                    "value": "PSD"
                }
            }
        },
        "/tools_window/biped/body/psd/arm_psd_io": {
            "instance": "/psd_io",
            "attrs": {
                "psd_system": {
                    "value": "arms"
                },
                "relative_path_stem": {
                    "type": "raw",
                    "value": "data/body/psd/arms"
                },
                "system_name": {
                    "type": "raw",
                    "value": "Arm"
                },
                "text": {
                    "value": "${title}"
                }
            }
        },
        "/tools_window/biped/body/psd/hand_psd_io": {
            "instance": "/psd_io",
            "attrs": {
                "blendshape": {
                    "type": "raw",
                    "value": "body_psd"
                },
                "psd_system": {
                    "value": "hands"
                },
                "relative_path_stem": {
                    "value": "data/body/psd/hands"
                },
                "system_name": {
                    "value": "Hand"
                },
                "text": {
                    "value": "${title}"
                }
            }
        },
        "/tools_window/biped/body/psd/leg_psd_io": {
            "instance": "/psd_io",
            "attrs": {
                "psd_system": {
                    "value": "legs"
                },
                "relative_path_stem": {
                    "value": "data/body/psd/legs"
                },
                "system_name": {
                    "value": "Leg"
                },
                "text": {
                    "value": "${title}"
                }
            }
        }
    }
}