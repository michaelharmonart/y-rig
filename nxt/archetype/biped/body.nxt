{
    "version": "1.17",
    "alias": "body",
    "color": "#662d82",
    "mute": false,
    "solo": false,
    "references": [
        "util/mgear.nxt"
    ],
    "meta_data": {
        "positions": {
            "/shifter_component_build": [
                -1095.9382886947733,
                19.226987520960936
            ]
        }
    },
    "nodes": {
        "/apply/deformation/main/skin/transfer_sim_weights": {
            "instance": "/transfer_skin_weights",
            "attrs": {
                "transfer_mapping": {
                    "type": "dict",
                    "value": "{}"
                }
            }
        },
        "/setup": {
            "child_order": [
                "shifter_component_build",
                "root"
            ]
        },
        "/setup/shifter_component_build": {
            "start_point": false,
            "instance": "/shifter_build",
            "child_order": [
                "attribute_defaults",
                "finger_meta_fix"
            ],
            "attrs": {
                "body_rig_temp_filepath": {
                    "type": "raw",
                    "value": "${export_root_path}/${body_rig_temp_relative_filepath}"
                },
                "body_rig_temp_relative_filepath": {
                    "type": "raw",
                    "value": "assets/.temp/body.mb"
                },
                "build_caching": {
                    "type": "bool",
                    "value": "True"
                },
                "custom_steps": {
                    "value": "False"
                },
                "export_root_path": {
                    "type": "raw",
                    "value": "${file::${rig_path}}"
                },
                "guide_filepath": {
                    "value": "${file::${rig_path}/data/guide.sgt}"
                }
            },
            "code": [
                "guide_path = Path(\"${guide_filepath}\")",
                "",
                "run_shifter_build = True",
                "body_rig_temp_filepath = Path(\"${body_rig_temp_filepath}\")",
                "if ${build_caching}:",
                "    if \"${build_scope}\" == \"face\":",
                "        if body_rig_temp_filepath.exists():",
                "            yrig.io.import_maya_file(body_rig_temp_filepath)",
                "            run_shifter_build = False",
                "        else:",
                "            run_shifter_build = True",
                "    else:",
                "        run_shifter_build = True",
                "        ",
                "    ",
                "if run_shifter_build:",
                "    result = yrig.build.mgear_api.build_from_shifter_file(guide_path, dev_build=${dev_build}, custom_steps=${custom_steps})",
                "    if result and ${build_caching}:",
                "        export_root_path = \"${export_root_path}\"",
                "        if not export_root_path or not Path(export_root_path).is_dir():",
                "            raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "        yrig.io.export_maya_file(body_rig_temp_filepath, binary=True, force=True)"
            ]
        },
        "/setup/shifter_component_build/attribute_defaults": {
            "code": [
                "for control in [\"armUI_L0_ctl\", \"armUI_R0_ctl\"]:",
                "    cmds.setAttr(f\"{control}.arm_ikref\", 5)",
                "",
                "for control in [\"legUI_L0_ctl\", \"legUI_R0_ctl\"]:",
                "    cmds.setAttr(f\"{control}.foot_angle_1\", -40)"
            ]
        },
        "/setup/shifter_component_build/finger_meta_fix": {
            "code": [
                "for side in [\"L\", \"R\"]:",
                "    for num in range(4):",
                "        control_name = f\"meta_{side}0_meta{num}_ctl\"",
                "        group_name = f\"finger_{side}{num}_root\"",
                "        cmds.parent(group_name, control_name)"
            ]
        },
        "/tools_window/biped/body": {
            "instance": "/panel",
            "child_order": [
                "psd"
            ],
            "attrs": {
                "text": {
                    "value": "Body"
                }
            }
        },
        "/tools_window/biped/body/psd": {
            "instance": "/panel",
            "child_order": [
                "hand_shapes_io"
            ],
            "attrs": {
                "text": {
                    "value": "PSD"
                }
            }
        },
        "/tools_window/biped/body/psd/hand_shapes_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "blendshape": {
                    "type": "raw",
                    "value": "body_psd"
                },
                "relative_filepath": {
                    "type": "raw",
                    "value": "data/body/psd/hands.yshape"
                },
                "text": {
                    "value": "Hand Shapes"
                }
            }
        },
        "/tools_window/biped/body/psd/hand_shapes_io/export": {
            "attrs": {
                "text": {
                    "value": "Export Hand Shapes"
                }
            },
            "code": [
                "export_root_path = \"${export_root_path}\"",
                "if not export_root_path or not Path(export_root_path).is_dir():",
                "    raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "export_path = Path(\"${export_path}\")",
                "",
                "yrig.deformer.blendshape.export_blendshape(export_path, \"${blendshape}\", directories={\"hands\"})"
            ]
        },
        "/tools_window/biped/body/psd/hand_shapes_io/import": {
            "attrs": {
                "text": {
                    "value": "Import Hand Shapes"
                }
            },
            "code": [
                "import_path = Path(\"${import_filepath}\")",
                "",
                "yrig.deformer.blendshape.import_blendshape(import_path, \"${blendshape}\")"
            ]
        }
    }
}