{
    "version": "1.17",
    "alias": "biped",
    "color": "#7a9e2b",
    "mute": false,
    "solo": false,
    "references": [
        "./face.nxt",
        "./body.nxt",
        "archetype/anim_rig.nxt"
    ],
    "comp_overrides": {
        "./body.nxt": {
            "mute": false
        },
        "./face.nxt": {
            "solo": false
        }
    },
    "meta_data": {
        "collapse": {
            "/apply/deformation/main/psd/arms": true,
            "/apply/deformation/main/psd/body/arms": true,
            "/apply/deformation/main/psd/body/hands": true,
            "/apply/deformation/main/psd/body/legs": true,
            "/apply/deformation/main/psd/body_psd/eyes/shapes": true,
