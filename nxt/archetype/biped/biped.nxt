{
    "version": "1.17",
    "alias": "biped",
    "color": "#7a9e2b",
    "mute": false,
    "solo": false,
    "references": [
        "./face.nxt",
        "./body.nxt",
        "archetype/anim_rig.nxt"
    ],
    "comp_overrides": {
        "./face.nxt": {
            "solo": false
        }
    },
    "meta_data": {
        "positions": {
            "/apply": [
                120.0,
                0.0
            ],
            "/build": [
                -360.0,
                0.0
            ],
            "/cleanup": [
                580.0,
                0.0
            ],
            "/component": [
                -360.0,
                -200.0
            ],
            "/ear_component": [
                -360.0,
                -560.0
            ],
            "/eye_component": [
                -360.0,
                -800.0
            ],
            "/eye_def": [
                -360.0,
                -380.0
            ],
            "/eyes_psd": [
                720.0,
                760.0
            ],
            "/face_base_component": [
                -360.0,
                -620.0
            ],
            "/look_component": [
                -360.0,
                -440.0
            ],
            "/mouth_component": [
                -360.0,
                -320.0
            ],
            "/nose_component": [
                -360.0,
                -740.0
            ],
            "/psd_import": [
                120.0,
                -320.0
            ],
            "/psd_layer": [
                120.0,
                -380.0
            ],
            "/setup": [
                -840.0,
                0.0
            ],
            "/shifter_build": [
                -1260.0,
                0.0
            ],
            "/side": [
                -360.0,
                -140.0
            ],
            "/simple_eyebrow": [
                -360.0,
                -680.0
            ],
            "/skin_geometry": [
                120.0,
                -200.0
            ],
            "/split_skin_weights": [
                120.0,
                -260.0
            ],
            "/teeth_component": [
                -360.0,
                -260.0
            ],
            "/tongue_component": [
                -360.0,
                -500.0
            ],
            "/transfer_skin_weights": [
                120.0,
                -140.0
            ]
        },
        "collapse": {
            "/apply/deformation/main/psd/body_psd/eyes": true,
            "/apply/deformation/main/psd/body_psd/eyes/shapes": true,
            "/apply/deformation/main/psd/body_psd/hands": true,
            "/build/left": false,
            "/build/left/ear": true,
            "/build/left/eye": true,
            "/build/left/eyebrow": true,
            "/build/middle": false,
            "/build/middle/face/base": true,
            "/build/middle/face/look": true,
            "/build/middle/face/mouth": true,
            "/build/middle/face/nose": true,
            "/build/middle/face/teeth": true,
            "/build/middle/face/tongue": true,
            "/build/right/ear": true,
            "/build/right/eye": true,
            "/build/right/eyebrow": true,
            "/ear_component": true,
            "/eye_component": true,
            "/face_base_component": true,
            "/look_component": true,
            "/mouth_component": true,
            "/nose_component": true,
            "/simple_eyebrow": true,
            "/teeth_component": true,
            "/tongue_component": true
        }
    },
    "nodes": {
        "/": {
            "attrs": {
                "rig_path": {
                    "value": "character/biped"
                }
            }
        },
        "/apply": {
            "child_order": [
                "rest_pose",
                "control_shapes",
                "deformation",
                "visibility_sets"
            ]
        },
        "/apply/visibility_sets": {
            "attrs": {
                "rig_set": {
                    "type": "raw",
                    "value": "${/setup/root.rig_set}"
                },
                "visibility_sets_filepath": {
                    "type": "raw",
                    "value": "${file::${rig_path}/data/visibility.ysets}"
                }
            },
            "code": [
                "if \"${visibility_sets_filepath}\":",
                "    filepath = Path(\"${visibility_sets_filepath}\")",
                "    yrig.sets.import_sets(filepath, parent=\"${rig_set}\")"
            ]
        },
        "/skin_geometry": {
            "attrs": {
                "dual_quaternion": {
                    "value": "True"
                }
            }
        },
        "/tools_window/biped": {
            "instance": "/tab",
            "child_order": [
                "visibility_sets_io"
            ],
            "attrs": {
                "text": {
                    "value": "Biped"
                }
            }
        },
        "/tools_window/biped/visibility_sets_io": {
            "instance": "/io_pair",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "relative_filepath": {
                    "value": "data/visibility.ysets"
                },
                "text": {
                    "value": "Visibility Sets"
                },
                "visibility_set_name": {
                    "type": "raw",
                    "value": "rig_visibility_sets"
                }
            }
        },
        "/tools_window/biped/visibility_sets_io/export": {
            "attrs": {
                "text": {
                    "value": "Export Visibility Sets"
                }
            },
            "code": [
                "export_root_path = \"${export_root_path}\"",
                "if not export_root_path or not Path(export_root_path).is_dir():",
                "    raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "export_path = Path(\"${export_path}\")",
                "",
                "yrig.sets.export_sets(export_path, \"${visibility_set_name}\")"
            ]
        },
        "/tools_window/biped/visibility_sets_io/import": {
            "attrs": {
                "rig_set": {
                    "type": "raw",
                    "value": "rig_sets_grp"
                },
                "text": {
                    "value": "Import Visibility Sets"
                }
            },
            "code": [
                "import_path = Path(\"${import_filepath}\")",
                "",
                "yrig.sets.import_sets(import_path, parent=\"${rig_set}\")"
            ]
        }
    }
}