            "/apply/deformation/main/psd/hands": true,
            "/apply/deformation/main/psd/legs": true,
            "/build/left": false,
            "/build/left/ear": true,
            "/build/left/eye": true,
            "/build/left/eyebrow": true,
            "/build/middle": false,
            "/build/middle/face/base": true,
            "/build/middle/face/look": true,
            "/build/middle/face/mouth": true,
            "/build/middle/face/nose": true,
            "/build/middle/face/teeth": true,
            "/build/middle/face/tongue": true,
            "/build/middle/optional_hat": true,
            "/build/right/ear": true,
            "/build/right/eye": true,
            "/build/right/eyebrow": true,
            "/ear_component": true,
            "/eye_component": true,
            "/face_base_component": true,
            "/io_pair": true,
            "/look_component": true,
            "/mouth_component": true,
            "/mouth_legacy_component": true,
            "/nose_component": true,
            "/psd_import": true,
            "/psd_io": true,
            "/psd_io/rbf_io": true,
            "/psd_io/shape_io": true,
            "/rbf_io": true,
            "/shape_io": true,
            "/simple_eyebrow": true,
            "/skin_data_io": true,
            "/teeth_component": true,
            "/tongue_component": true,
            "/tools_window/biped/body/psd/arm_psd_io": true,
            "/tools_window/biped/body/psd/arm_shapes_io": false,
            "/tools_window/biped/body/psd/arms_psd_io": true,
            "/tools_window/biped/body/psd/hand_psd_io": true,
            "/tools_window/biped/body/psd/hand_shapes_io": false,
            "/tools_window/biped/body/psd/leg_psd_io": true,
            "/tools_window/biped/body/psd/leg_shapes_io": false,
            "/tools_window/biped/face/face_guides_io": true,
            "/tools_window/biped/face/guides/face_guides_io": true,
            "/tools_window/biped/face/guides/mouth_surf_skin_io": true,
            "/tools_window/biped/face/guides/mouth_surface_io": true,
            "/tools_window/biped/face/guides/solo_face_guides_io": true,
            "/tools_window/biped/face/mouth_surf_skin_io": true,
            "/tools_window/biped/face/mouth_surface_io": true,
            "/tools_window/biped/face/psd/eye_psd_io": true,
            "/tools_window/biped/face/psd/mouth_psd_io": true,
            "/tools_window/biped/face/skin_data_io": true,
            "/tools_window/biped/face/solo_face_guides_io": true,
            "/tools_window/tools/mgear/shifter_guides_io": true
        },
        "positions": {
            "/apply": [
                120.0,
                0.0
            ],
            "/build": [
                -360.0,
                0.0
            ],
            "/ear_component": [
                -360.0,
                -660.0
            ],
            "/eye_component": [
                -360.0,
                -360.0
            ],
            "/eye_def": [
                -360.0,
                -420.0
            ],
            "/face_base_component": [
                -360.0,
                -240.0
            ],
            "/finalize": [
                600.0,
                0.0
            ],
            "/look_component": [
                -360.0,
                -480.0
            ],
            "/mouth_component": [
                -360.0,
                -840.0
            ],
            "/mouth_legacy_component": [
                -360.0,
                -600.0
            ],
            "/nose_component": [
                -360.0,
                -540.0
            ],
            "/psd_import": [
                120.0,
                -300.0
            ],
            "/shifter_build": [
                -840.0,
                -120.0
            ],
            "/simple_eyebrow": [
                -360.0,
                -300.0
            ],
            "/skin_geometry": [
                120.0,
                -180.0
            ],
            "/teeth_component": [
                -360.0,
                -720.0
            ],
            "/tongue_component": [
                -360.0,
                -780.0
            ]
        }
    },
    "nodes": {
        "/": {
            "attrs": {
                "rig_path": {
                    "value": "character/biped"
                }
            }
        },
        "/build/middle/optional_hat": {
            "attrs": {
                "build": {
                    "type": "bool",
                    "value": "False"
                },
                "control_parent": {
                    "type": "raw",
                    "value": "face_top_M_ctl"
                },
                "control_size": {
                    "type": "float",
                    "value": "1.0"
                },
                "guide": {
                    "type": "raw",
                    "value": "face_top_M"
                },
                "joint_parent": {
                    "type": "raw",
                    "value": "face_top_M_jnt"
                },
                "name": {
                    "type": "raw",
                    "value": "hat"
                }
            },
            "code": [
                "from yrig.joint import create_joint",
                "from yrig.control import create_control",
                "",
                "",
                "guide = \"${guide}\"",
                "name = \"${name}\"",
                "side = \"${side}\"",
                "control_parent = \"${control_parent}\"",
                "joint_parent = \"${joint_parent}\"",
                "control_size = float(${control_size})",
                "build: bool = ${build}",
                "",
                "if build:",
                "    ctrl = create_control(",
                "        name=f\"{name}_{side}\",",
                "        parent=control_parent,",
                "        transform=guide,",
                "        size=control_size,",
                "        control_shape=\"circle\",",
                "    )",
                "",
                "    jnt = create_joint(",
                "        name=f\"{name}_{side}\",",
                "        parent=joint_parent,",
                "        transform=ctrl.transform,",
                "    )"
            ]
        },
        "/skin_geometry": {
            "attrs": {
                "dual_quaternion": {
                    "value": "True"
                }
            }
        },
        "/tools_window/biped": {
            "instance": "/tab",
            "attrs": {
                "text": {
                    "value": "Biped"
                }
            }
        }
    }
}