{
    "version": "1.17",
    "alias": "core",
    "color": "#4287f5",
    "mute": false,
    "solo": false,
    "meta_data": {
        "positions": {
            "/component": [
                -837.8869932007051,
                -236.98495341223884
            ],
            "/side": [
                -834.5843920777024,
                -166.47619365105209
            ]
        }
    },
    "nodes": {
        "/": {
            "code": [
                "# Reload yrig automatically on build or workflow tool run for convenience.",
                "import sys",
                "modules = [name for name in sys.modules.keys() if name.startswith(\"yrig\")]",
                "for name in modules:",
                "    del sys.modules[name]",
                "import yrig",
                "",
                "from maya import cmds",
                "",
                "from pathlib import Path",
                "import logging",
                "self.log = logging.getLogger(\"yrig.nxt.build\")",
                "",
                ""
            ]
        },
        "/component": {
            "attrs": {
                "component_group": {
                    "comment": "Name of the group created to house this components internal logic nodes,",
                    "type": "raw",
                    "value": "${name}_${side}_root"
                },
                "control_group": {
                    "type": "raw",
                    "value": "${name}_${side}_ctls"
                },
                "control_parent": {
                    "comment": "Parent for the controls of this component",
                    "type": "raw",
                    "value": "${component_group}"
                },
                "joint_parent": {
                    "comment": "Parent for the joints of this component."
                },
                "name": {
                    "comment": "Name for this component"
                },
                "parent": {
                    "comment": "Parent for the component's rig nodes."
                },
                "side": {
                    "type": "raw",
                    "value": "M"
                },
                "socket": {
                    "comment": "The transform to physically attach this component to",
                    "type": "raw",
                    "value": "${pareent}"
                }
            },
            "code": [
                "self.component_group = yrig.transform.create_transform(name=\"${component_group}\", parent=\"${parent}\")",
                "",
                "self.control_group = yrig.transform.create_transform(name=\"${control_group}\", parent=\"${control_parent}\")",
                "cmds.setAttr(f\"{self.control_group}.overrideEnabled\", True)",
                "cmds.setAttr(f\"{self.control_group}.drawOverride.overrideRGBColors\", True)",
                "cmds.connectAttr(\"${control_layer}.controlColor\", f\"{self.control_group}.drawOverride.overrideColorRGB\")"
            ]
        },
        "/side": {
            "attrs": {
                "control_color": {
                    "comment": "RGB values for the control colors in this layer",
                    "type": "list",
                    "value": "[0.105, 0.247, 0.411]"
                },
                "control_layer": {
                    "comment": "Name of the created control layer node that holds the control color.",
                    "type": "raw",
                    "value": "${side}_ControlLayer"
                },
                "side": {
                    "comment": "The side token to use in child nodes.",
                    "type": "raw",
                    "value": "M"
                },
                "side_mult": {
                    "comment": "Positive or negative 1, representing handedness of the space for the child components.",
                    "type": "int",
                    "value": "1"
                }
            },
            "code": [
                "settings = cmds.createNode(\"network\", name=\"${control_layer}\")",
                "cmds.addAttr(settings, longName='controlColor', usedAsColor=True, attributeType='float3' )",
                "cmds.addAttr(settings, longName='controlColorR', attributeType='float', parent='controlColor')",
                "cmds.addAttr(settings, longName='controlColorG', attributeType='float', parent='controlColor')",
                "cmds.addAttr(settings, longName='controlColorB', attributeType='float', parent='controlColor')",
                "",
                "cmds.setAttr(f\"{settings}.controlColor\", type=\"float3\", *${control_color})",
                "",
                "cmds.refresh()"
            ]
        }
    }
}