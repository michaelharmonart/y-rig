    "nodes": {
        "/io_pair": {
            "instance": "/gridLayout",
            "child_order": [
                "import",
                "export"
            ],
            "attrs": {
                "import_filepath": {
                    "type": "raw",
                    "value": "${file::${rig_path}/${relative_filepath}}"
                },
                "pair_name": {
                    "type": "raw",
                    "value": "Data"
                },
                "relative_filepath": {
                    "type": "raw",
                    "value": "data"
                }
            }
        },
        "/io_pair/export": {
            "instance": "/button",
            "attrs": {
                "export_path": {
                    "type": "raw",
                    "value": "${export_root_path}/${relative_filepath}"
                },
                "export_root_path": {
                    "type": "raw",
                    "value": "${file::${rig_path}}"
                },
                "force": {
                    "type": "bool",
                    "value": "False"
                },
                "title": {
                    "type": "raw",
                    "value": "Export ${pair_name}"
                }
            },
            "code": [
                "export_root_path = \"${export_root_path}\"",
                "if not export_root_path or not Path(export_root_path).is_dir():",
                "    raise ValueError(f\"Invalid directory: {export_root_path}\")",
                "export_path = Path(\"${export_path}\")"
            ]
        },
        "/io_pair/import": {
            "instance": "/button",
            "attrs": {
                "title": {
                    "type": "raw",
                    "value": "Import ${pair_name}"
                }
            },
            "code": [
                "import_path = Path(\"${import_filepath}\")"
            ]
        },
        "/tools_window": {
            "instance": "/window",
            "child_order": [
                "tools"
            ],
            "attrs": {
                "_widget_window": {
                    "value": "True"
                }
            }
        },
        "/tools_window/tools": {
            "instance": "/tab",
            "child_order": [
                "geometry",
                "skin",
                "blendshape",
                "pose"
            ],
            "attrs": {
                "text": {
                    "value": "Tools"
                }
            }
        },
        "/tools_window/tools/blendshape": {
            "instance": "/panel",
            "child_order": [
                "layout"
            ],
            "attrs": {
                "text": {
                    "type": "raw",
                    "value": "BlendShape"
                }
            }
        },
        "/tools_window/tools/blendshape/layout": {
            "instance": "/gridLayout",
            "child_order": [
                "mirror_blendshapes",
                "reset_target_delta",
                "copy_target_delta"
            ]
        },
        "/tools_window/tools/blendshape/layout/copy_target_delta": {
            "instance": "/button",
            "child_order": [
                "add_target_delta"
            ],
            "attrs": {
                "text": {
                    "value": "Copy Target Delta"
                }
            },
            "code": [
                "log = yrig.build.nxt_api.get_node_logger(\"${_nxtpath}\")",
                "",
                "selected_targets = yrig.deformer.blendshape.shape_editor.get_selected_blendshape_targets()",
                "if len(selected_targets) != 2:",
                "    raise RuntimeError(\"Wrong number of targets selected. Must select exactly two targets for target delta copy (source, destination).\")",
                "    ",
                "source_target = selected_targets[0]",
                "destination_target = selected_targets[-1]",
                "blendshape = source_target.blendshape",
                "yrig.deformer.blendshape.copy_target_deltas(blendshape, source_target.target_index, destination_target.target_index)",
                "log.info(f\"Copied target deltas from {source_target} to {destination_target} (overwrite)\")"
            ]
        },
        "/tools_window/tools/blendshape/layout/copy_target_delta/add_target_delta": {
            "instance": "/menuItem",
            "attrs": {
                "text": {
                    "value": "Copy Target Delta (Add)"
                }
            },
            "code": [
                "log = yrig.build.nxt_api.get_node_logger(\"${_nxtpath}\")",
                "",
                "selected_targets = yrig.deformer.blendshape.shape_editor.get_selected_blendshape_targets()",
                "if len(selected_targets) != 2:",
                "    raise RuntimeError(\"Wrong number of targets selected. Must select exactly two targets for target delta copy (source, destination).\")",
                "    ",
                "source_target = selected_targets[0]",
                "destination_target = selected_targets[-1]",
                "blendshape = source_target.blendshape",
                "yrig.deformer.blendshape.copy_target_deltas(",
                "    blendshape, ",
                "    source_target.target_index, ",
                "    destination_target.target_index, ",
                "    replace=False,",
                ")",
                "log.info(f\"Copied target deltas from {source_target} to {destination_target} (add)\")"
            ]
        },
        "/tools_window/tools/blendshape/layout/mirror_blendshapes": {
            "instance": "/button",
            "attrs": {
                "text": {
                    "value": "Mirror BlendShapes"
                }
            },
            "code": [
                "log = yrig.build.nxt_api.get_node_logger(\"${_nxtpath}\")",
                "",
                "selection = yrig.select.get_selection()",
                "",
                "for node in selection:",
                "    blendshape = yrig.deformer.blendshape.resolve_blendshape(node)",
                "    if node is not None:",
                "        yrig.deformer.blendshape.mirror_all_blendshape_targets(blendshape)",
                "        log.info(f\"Mirrored all blendShape targets on {blendshape}\")"
            ]
        },
        "/tools_window/tools/blendshape/layout/reset_target_delta": {
            "instance": "/button",
            "attrs": {
                "text": {
                    "type": "raw",
                    "value": "Reset Target Delta"
                }
            },
            "code": [
                "log = yrig.build.nxt_api.get_node_logger(\"${_nxtpath}\")",
                "",
                "selected_targets = yrig.deformer.blendshape.shape_editor.get_selected_blendshape_targets()",
                "for target in selected_targets:",
                "    yrig.deformer.blendshape.reset_target_delta(target.blendshape, target.target_index)",
                "target_names = [str(target) for target in selected_targets]",
                "log.info(f\"Reset the deltas on {target_names}\")"
            ]
        },
        "/tools_window/tools/geometry": {
            "instance": "/panel",
            "child_order": [
                "layout"
            ],
            "attrs": {
                "text": {
                    "value": "Geometry"
                }
            }
        },
        "/tools_window/tools/geometry/layout": {
            "instance": "/gridLayout",
            "child_order": [
                "bake_face_colors"
            ]
        },
        "/tools_window/tools/geometry/layout/bake_face_colors": {
            "instance": "/button",
            "attrs": {
                "text": {
                    "value": "Bake Face Colors"
                }
            },
            "code": [
                "from yrig.color.bake import face_color_from_texture",
                "",
                "selection = cmds.ls(selection=True)",
                "with yrig.progress.progress_step(\"Bake Face Colors\", total=len(selection)):",
                "    for object in selection:",
                "        try:",
                "            with yrig.progress.progress_step(object):",
                "                face_color_from_texture(object)",
                "        except Exception as e:",
                "            log = yrig.build.nxt_api.get_node_logger(\"${_nxtpath}\")",
                "            log.warning(f\"Couldn't bake face colors for {object}, {e}\")"
            ]
        },
        "/tools_window/tools/pose": {
            "instance": "/panel",
            "child_order": [
                "layout"
            ],
            "attrs": {
                "text": {
                    "value": "Pose"
                }
            }
        },
        "/tools_window/tools/pose/layout": {
            "instance": "/gridLayout",
            "child_order": [
                "mirror_pose_interpolator",
                "update_pose"
            ]
        },
        "/tools_window/tools/pose/layout/mirror_pose_interpolator": {
            "instance": "/button",
            "attrs": {
                "text": {
                    "type": "raw",
                    "value": "Mirror Pose Interpolator"
                }
            },
            "code": [
                "selected_pose_interpolators = yrig.rbf.pose_interpolator.pose_editor.get_selected_pose_interpolators()",
                "yrig.rbf.pose_interpolator.mirror.mirror_pose_interpolators(selected_pose_interpolators)"
            ]
        },
        "/tools_window/tools/pose/layout/update_pose": {
            "instance": "/button",
            "attrs": {
                "text": {
                    "value": "Update Pose"
                }
            },
            "code": [
                "selected_poses = yrig.rbf.pose_interpolator.pose_editor.get_selected_poses()",
                "if len(selected_poses) != 1:",
                "    raise RuntimeError(\"Select exactly one pose in the pose editor.\")",
                "pose = selected_poses[0]",
                "",
                "yrig.rbf.pose_interpolator.pose.update_pose(pose.pose_interpolator, pose.pose_index)"
            ]
        },
        "/tools_window/tools/skin": {
            "instance": "/panel",
            "child_order": [
                "layout"
            ],
            "attrs": {
                "text": {
                    "value": "Skin"
                }
            }
        },
        "/tools_window/tools/skin/layout": {
            "instance": "/gridLayout",
            "child_order": [
                "split_skin_weights",
                "transfer_skin"
            ]
        },
        "/tools_window/tools/skin/layout/split_skin_weights": {
            "instance": "/button",
            "child_order": [
                "split_ng_layer_weights"
            ],
            "attrs": {
                "text": {
                    "value": "Split Skin Weights"
                }
            },
            "code": [
                "selection = yrig.select.get_selection()",
                "yrig.skin.split.auto_split_weights(selection)"
            ]
        },
        "/tools_window/tools/skin/layout/split_skin_weights/split_ng_layer_weights": {
            "instance": "/menuItem",
            "attrs": {
                "text": {
                    "type": "raw",
                    "value": "Split Ng Layer Weights"
                }
            },
            "code": [
                "selection = yrig.select.get_selection()",
                "if len(selection) != 1:",
                "    raise RuntimeError(\"Select exactly one geometry with ng skin data.\")",
                "yrig.skin.split.ng.split_ng_layer_weights(selection[0])"
            ]
        },
        "/tools_window/tools/skin/layout/transfer_skin": {
            "instance": "/button",
            "attrs": {
                "text": {
                    "value": "Transfer Skin"
                }
            },
            "code": [
                "log = yrig.build.nxt_api.get_node_logger(\"${_nxtpath}\")",
                "selection = cmds.ls(selection=True)",
                "if len(selection) != 2:",
                "    raise RuntimeError(\"Select the source geo, then the target geo.\")",
                "source = selection[0]",
                "dest = selection[-1]",
                "yrig.skin.transfer_skin(source, dest)",
                "log.info(f\"Transferred skin from {source} to {dest}\")"
            ]
        }
    }
}