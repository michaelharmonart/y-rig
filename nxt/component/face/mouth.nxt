{
    "version": "1.17",
    "alias": "mouth",
    "color": "#0052aa",
    "mute": false,
    "solo": false,
    "meta_data": {
        "positions": {
            "/mouth_component": [
                -1011.9459426257373,
                318.3094795136238
            ]
        }
    },
    "nodes": {
        "/mouth_component": {
            "instance": "/component",
            "child_order": [
                "build",
                "skin_surface"
            ],
            "attrs": {
                "control_parent": {
                    "type": "raw",
                    "value": "${component_group}"
                },
                "control_size": {
                    "type": "int",
                    "value": "2"
                },
                "name": {
                    "value": "mouth"
                },
                "parent": {
                    "type": "raw",
                    "value": "face_grp"
                }
            }
        },
        "/mouth_component/build": {
            "code": [
                "from yrig.component.mouth import Mouth, MouthGuides, LipGuides, CheekInterpolateGuides",
                "",
                "left_corner_guide = \"mouth_corner_L\"",
                "right_corner_guide = \"mouth_corner_R\"",
                "",
                "upper_lip_guides = LipGuides(",
                "    lip_mid_left = \"upper_lip_mid_L\",",
                "    lip_mid =\"upper_lip_mid_M\",",
                "    lip_mid_right=\"upper_lip_mid_R\")",
                "lower_lip_guides = LipGuides(",
                "    lip_mid_left = \"lower_lip_mid_L\",",
                "    lip_mid = \"lower_lip_mid_M\",",
                "    lip_mid_right = \"lower_lip_mid_R\")",
                "",
                "cheek_interpolate_guides = CheekInterpolateGuides(",
                "    max_upper_mid_cv = \"mouth_interpolate_max_M_upper_jnt\",",
                "    max_lower_mid_cv = \"mouth_interpolate_max_M_lower_jnt\",",
                "    max_left_corner = \"mouth_interpolate_max_L_corner_jnt\",",
                "    max_right_corner = \"mouth_interpolate_max_R_corner_jnt\",",
                "    max_upper_left_cvs = (",
                "        \"mouth_interpolate_max_L_upper_cv0_jnt\",",
                "        \"mouth_interpolate_max_L_upper_cv1_jnt\",",
                "    ),",
                "    max_upper_right_cvs = (",
                "        \"mouth_interpolate_max_R_upper_cv0_jnt\",",
                "        \"mouth_interpolate_max_R_upper_cv1_jnt\",",
                "    ),",
                "    max_lower_left_cvs = (",
                "        \"mouth_interpolate_max_L_lower_cv0_jnt\",",
                "        \"mouth_interpolate_max_L_lower_cv1_jnt\",",
                "    ),",
                "    max_lower_right_cvs = (",
                "        \"mouth_interpolate_max_R_lower_cv0_jnt\",",
                "        \"mouth_interpolate_max_R_lower_cv1_jnt\",",
                "    ),",
                ")",
                "",
                "mouth_guides = MouthGuides(",
                "    mouth = \"mouth_M\",",
                "    mouth_surface = \"face_surface\",",
                "    jaw = \"jaw_M\",",
                "    left_corner = left_corner_guide,",
                "    right_corner = right_corner_guide,",
                "    upper_lip = upper_lip_guides,",
                "    lower_lip = lower_lip_guides,",
                "    cheek_interpolate = cheek_interpolate_guides,",
                ")",
                "",
                "with yrig.control.collect_controls() as component_controls:",
                "    mouth = Mouth(",
                "        guides=mouth_guides, ",
                "        parent=\"${component_group}\",",
                "        control_parent=\"${control_parent}\", ",
                "        joint_parent=\"${joint_parent}\", ",
                "        control_size=${control_size}",
                "    )",
                "    ",
                "STAGE.control_list.extend(component_controls)"
            ]
        },
        "/mouth_component/skin_surface": {
            "attrs": {
                "mouth_surface_skin_filepath": {
                    "type": "raw",
                    "value": "${file::data/face/mouth_surface.yskin}"
                }
            },
            "code": [
                "mouth_surface_skin = Path(\"${mouth_surface_skin_filepath}\")",
                "",
                "yrig.skin.skin_geometry(bind_joints=[\"face_jnt\", \"jaw_M_jnt\"], geometry=\"mouth_surface\")",
                "yrig.skin.import_skin_weights(filepath=mouth_surface_skin, geometry=\"mouth_surface\")"
            ]
        }
    }
}